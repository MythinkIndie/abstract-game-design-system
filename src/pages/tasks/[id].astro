---
// src/pages/tasks/[id].astro
import { db } from '../../lib/db';

const { id } = Astro.params;

const task = db.prepare('SELECT * FROM entries WHERE id = ?').get(id);

if (!task) {
  return Astro.redirect('/tasks');
}

const taskData = JSON.parse((task as any).data);

// Obtener categoría relacionada si existe
let relatedCategory = null;
if (taskData.related_category_id) {
  relatedCategory = db.prepare('SELECT * FROM categories WHERE id = ?').get(taskData.related_category_id);
}

// Obtener subtareas
const taskCategory = db.prepare('SELECT id FROM categories WHERE slug = ?').get('task') as any;
const subtasks = taskCategory ? db.prepare(`
  SELECT * FROM entries 
  WHERE category_id = ? AND json_extract(data, '$.parent_task_id') = ?
  ORDER BY json_extract(data, '$.order_index') ASC, created_at ASC
`).all(taskCategory.id, id) : [];

// Obtener tarea padre si existe
let parentTask = null;
if (taskData.parent_task_id) {
  parentTask = db.prepare('SELECT * FROM entries WHERE id = ?').get(taskData.parent_task_id) as any;
  if (parentTask) {
    parentTask.data = JSON.parse(parentTask.data);
  }
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{taskData.title} - Tarea</title>
</head>
<body class="bg-gray-50 min-h-screen">
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <a href="/tasks" class="text-sm text-gray-500 hover:text-gray-700">← Volver a tareas</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1">{taskData.title}</h1>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white rounded-lg shadow border border-gray-200 p-8">
      {parentTask && (
        <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
          <p class="text-sm text-blue-900">
            <strong>Subtarea de:</strong> 
            <a href={`/tasks/${parentTask.id}`} class="underline hover:text-blue-700">
              {parentTask.data.title}
            </a>
          </p>
        </div>
      )}

      <div class="space-y-6">
        <!-- Estado -->
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2">
            <input 
              type="checkbox" 
              id="completedCheckbox"
              checked={taskData.is_completed}
              class="w-5 h-5 rounded"
            />
            <span class="font-medium">Tarea completada</span>
          </label>
          
          <span class={`px-3 py-1 rounded text-sm font-medium ${
            taskData.priority === 'critical' ? 'bg-red-100 text-red-700' :
            taskData.priority === 'high' ? 'bg-orange-100 text-orange-700' :
            taskData.priority === 'medium' ? 'bg-blue-100 text-blue-700' :
            'bg-gray-100 text-gray-600'
          }`}>
            Prioridad: {taskData.priority === 'critical' ? '🔥 Crítica' :
                       taskData.priority === 'high' ? '⬆️ Alta' :
                       taskData.priority === 'medium' ? '➡️ Media' :
                       '⬇️ Baja'}
          </span>
        </div>

        <!-- Descripción -->
        {taskData.description && (
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Descripción</h3>
            <div class="prose max-w-none">
              {taskData.description}
            </div>
          </div>
        )}

        <!-- Categoría relacionada -->
        {relatedCategory && (
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Categoría Relacionada</h3>
            <a 
              href={`/categories/${(relatedCategory as any).slug}`}
              class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg hover:bg-gray-200"
            >
              <div class="w-6 h-6 rounded" style={`background-color: ${(relatedCategory as any).color}`}></div>
              {(relatedCategory as any).name}
            </a>
            <p class="text-sm text-gray-500 mt-2">
              {taskData.applies_to_all ? 
                '✨ Aplica a todas las entradas de esta categoría' :
                `🎯 Aplica a ${taskData.specific_entry_ids?.length || 0} entradas específicas`
              }
            </p>
          </div>
        )}

        {taskData.specific_entry_ids && taskData.specific_entry_ids.length > 0 && (
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">
              Entradas vinculadas ({taskData.specific_entry_ids.length})
            </h3>
            <div class="space-y-2">
              {taskData.specific_entry_ids.map((entryId: string) => {
                const entry = db.prepare('SELECT * FROM entries WHERE id = ?').get(entryId) as any;
                if (!entry) return null;
                
                const entryCategory = db.prepare('SELECT * FROM categories WHERE id = ?').get(entry.category_id) as any;
                
                return (
                  <div class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-indigo-300">
                    <div class="w-2 h-2 rounded-full" style={`background-color: ${entryCategory.color}`}></div>
                    <div class="flex-1">
                      <a 
                        href={`/entries/${entryCategory.slug}/${entry.id}`}
                        class="font-medium text-gray-900 hover:text-indigo-600"
                      >
                        {entry.title}
                      </a>
                      <p class="text-xs text-gray-500">{entryCategory.name}</p>
                    </div>
                    <button 
                      class="unlink-entry text-gray-400 hover:text-red-600"
                      data-entry-id={entry.id}
                      title="Desvincular entrada"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </button>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        <!-- Metadata -->
        <div class="grid grid-cols-2 gap-4 pt-4 border-t">
          {taskData.due_date && (
            <div>
              <h4 class="text-sm font-medium text-gray-500">Fecha Límite</h4>
              <p class="text-gray-900">{new Date(taskData.due_date).toLocaleDateString('es-ES')}</p>
            </div>
          )}
          
          <div>
            <h4 class="text-sm font-medium text-gray-500">Creada</h4>
            <p class="text-gray-900">{new Date((task as any).created_at).toLocaleDateString('es-ES')}</p>
          </div>

          {taskData.assigned_to && (
            <div>
              <h4 class="text-sm font-medium text-gray-500">Asignado a</h4>
              <div class="flex items-center gap-2 mt-1">
                <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-semibold text-sm">
                  {taskData.assigned_to.substring(0, 2).toUpperCase()}
                </div>
                <p class="text-gray-900">{taskData.assigned_to}</p>
              </div>
            </div>
          )}

          <!-- Sección de comentarios (al final del contenido) -->
          {taskData.comments && taskData.comments.length > 0 && (
            <div class="pt-6 border-t">
              <h3 class="font-semibold text-gray-900 mb-3">
                Comentarios ({taskData.comments.length})
              </h3>
              <div class="space-y-3">
                {taskData.comments.map((comment: any) => (
                  <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                    <div class="flex items-start gap-3">
                      <div class="w-8 h-8 rounded-full bg-gray-400 text-white flex items-center justify-center font-semibold text-xs">
                        {comment.user ? comment.user.substring(0, 2).toUpperCase() : '??'}
                      </div>
                      <div class="flex-1">
                        <div class="flex items-center justify-between mb-1">
                          <span class="font-medium text-sm text-gray-900">
                            {comment.user || 'Usuario'}
                          </span>
                          <span class="text-xs text-gray-500">
                            {new Date(comment.timestamp).toLocaleString('es-ES')}
                          </span>
                        </div>
                        <p class="text-sm text-gray-700">{comment.text}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Formulario para añadir comentario -->
          <div class="pt-4 border-t">
            <h4 class="font-semibold text-gray-900 mb-2">Añadir comentario</h4>
            <div class="flex gap-2">
              <input 
                type="text" 
                id="newComment"
                placeholder="Escribe un comentario..."
                class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
              <button 
                id="addCommentBtn"
                class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium"
              >
                Comentar
              </button>
            </div>
          </div>
        </div>

        <!-- Etiquetas -->
        {taskData.tags && taskData.tags.length > 0 && (
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Etiquetas</h3>
            <div class="flex flex-wrap gap-2">
              {taskData.tags.map((tag: string) => (
                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Subtareas -->
        {subtasks.length > 0 && (
          <div class="pt-4 border-t">
            <h3 class="font-semibold text-gray-900 mb-3">Subtareas ({subtasks.length})</h3>
            <div class="space-y-2">
              {subtasks.map((subtask: any) => {
                const subData = JSON.parse(subtask.data);
                return (
                  <a 
                    href={`/tasks/${subtask.id}`}
                    class="block p-3 border border-gray-200 rounded-lg hover:border-indigo-300 hover:bg-gray-50"
                  >
                    <div class="flex items-center gap-3">
                      <input 
                        type="checkbox" 
                        checked={subData.is_completed}
                        class="w-4 h-4 rounded pointer-events-none"
                      />
                      <span class={subData.is_completed ? 'line-through text-gray-500' : ''}>
                        {subData.title}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- Acciones -->
        <div class="flex gap-3 pt-6 border-t">
          <a 
            href={`/tasks/create?parent_id=${id}&category_id=${taskData.related_category_id || ''}`}
            class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200"
          >
            + Añadir Subtarea
          </a>
          <button 
            id="deleteBtn"
            class="px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100"
          >
            Eliminar Tarea
          </button>
        </div>
      </div>
    </div>
  </main>

  <script>
    const taskId = window.location.pathname.split('/').pop();
    
    // Marcar como completada
    document.getElementById('completedCheckbox')?.addEventListener('change', async (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      
      try {
        const response = await fetch('/api/tasks', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: taskId,
            is_completed: checked
          })
        });
        
        if (response.ok) {
          window.location.reload();
        }
      } catch (error) {
        alert('Error al actualizar');
      }
    });

    document.getElementById('addCommentBtn')?.addEventListener('click', async () => {
      const input = document.getElementById('newComment') as HTMLInputElement;
      const text = input.value.trim();
      
      if (!text) return;
      
      const taskId = window.location.pathname.split('/').pop();
      
      // Obtener tarea actual
      const response = await fetch(`/api/entries?id=${taskId}`);
      const task = await response.json();
      const data = JSON.parse(task.data);
      
      // Añadir nuevo comentario
      const newComment = {
        user: 'Usuario Actual', // TODO: integrar con sistema de usuarios
        text: text,
        timestamp: new Date().toISOString()
      };
      
      if (!data.comments) data.comments = [];
      data.comments.push(newComment);
      
      // Guardar
      await fetch('/api/entries', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: taskId,
          data: data
        })
      });
      
      window.location.reload();
    });

    // Eliminar tarea
    document.getElementById('deleteBtn')?.addEventListener('click', async () => {
      if (!confirm('¿Eliminar esta tarea y todas sus subtareas?')) return;
      
      try {
        const response = await fetch('/api/tasks', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: taskId })
        });
        
        if (response.ok) {
          window.location.href = '/tasks';
        }
      } catch (error) {
        alert('Error al eliminar');
      }
    });

    document.querySelectorAll('.unlink-entry').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const entryId = target.dataset.entryId!;
        
        if (!confirm('¿Desvincular esta entrada de la tarea?')) return;
        
        try {
          // Obtener tarea actual
          const response = await fetch(`/api/entries?id=${taskId}`);
          const task = await response.json();
          const taskData = JSON.parse(task.data);
          
          // Quitar entry_id
          const specificIds = (taskData.specific_entry_ids || []).filter((id: string) => id !== entryId);
          
          const updateResponse = await fetch('/api/tasks', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: taskId,
              specific_entry_ids: specificIds
            })
          });
          
          if (updateResponse.ok) {
            window.location.reload();
          }
        } catch (error) {
          alert('Error al desvincular');
        }
      });
    });
  </script>
</body>
</html>