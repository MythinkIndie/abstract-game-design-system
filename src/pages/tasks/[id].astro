---
// src/pages/tasks/[id].astro
import { db } from '@/lib/db';

const { id } = Astro.params;

const task = db.prepare('SELECT * FROM entries WHERE id = ?').get(id);

if (!task) {
  return Astro.redirect('/tasks');
}

const taskData = JSON.parse((task as any).data);

// Obtener categoría relacionada si existe
let relatedCategory = null;
if (taskData.related_category_id) {
  relatedCategory = db.prepare('SELECT * FROM categories WHERE id = ?').get(taskData.related_category_id);
}

// Obtener subtareas
const taskCategory = db.prepare('SELECT id FROM categories WHERE slug = ?').get('task') as any;
const subtasks = taskCategory ? db.prepare(`
  SELECT * FROM entries 
  WHERE category_id = ? AND json_extract(data, '$.parent_task_id') = ?
  ORDER BY json_extract(data, '$.order_index') ASC, created_at ASC
`).all(taskCategory.id, id) : [];

// Obtener tarea padre si existe
let parentTask = null;
if (taskData.parent_task_id) {
  parentTask = db.prepare('SELECT * FROM entries WHERE id = ?').get(taskData.parent_task_id) as any;
  if (parentTask) {
    parentTask.data = JSON.parse(parentTask.data);
  }
}

// Obtener categorías para selector
const categories = db.prepare('SELECT id, name, slug FROM categories WHERE is_system = 0 ORDER BY name').all();

// Obtener entradas de la categoría relacionada
let categoryEntries: any[] = [];
if (taskData.related_category_id) {
  categoryEntries = db.prepare('SELECT id, title FROM entries WHERE category_id = ? ORDER BY title')
    .all(taskData.related_category_id);
}

const taskStatuses = db.prepare('SELECT * FROM task_statuses ORDER BY order_index').all() as any[];

let statusOptions: any[] = taskStatuses;
if (statusOptions.length === 0) {
  const taskFields = db.prepare('SELECT * FROM fields WHERE category_id = ?').all(taskCategory.id) as any[];
  const statusField = taskFields.find((f: any) => f.name === 'status' && f.type === 'enum');
  
  if (statusField) {
    try {
      const config = JSON.parse(statusField.config);
      if (config.options && Array.isArray(config.options)) {
        statusOptions = config.options.map((opt: string) => ({
          name: opt,
          label: opt,
          color: '#6b7280',
          icon: '•'
        }));
      }
    } catch {}
  }
}

const taskFields = db.prepare('SELECT * FROM fields WHERE category_id = ?').all(taskCategory.id) as any[];
const priorityField = taskFields.find((f: any) => f.name === 'priority' && f.type === 'enum');

let priorityOptions = ['low', 'medium', 'high', 'critical'];
if (priorityField) {
  try {
    const config = JSON.parse(priorityField.config);
    if (config.options && Array.isArray(config.options)) {
      priorityOptions = config.options;
    }
  } catch {}
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{taskData.title} - Tarea</title>
  <style>
    .editable-input {
      border: 2px solid transparent;
      transition: all 0.2s;
    }
    .editable-input:hover {
      border-color: #e5e7eb;
      background-color: #f9fafb;
    }
    .editable-input:focus {
      border-color: #6366f1;
      background-color: white;
      outline: none;
    }
    .section-card {
      background: white;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 1rem;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen" data-task-id={id}>
  <header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex items-center justify-between">
        <a href="/tasks" class="text-sm text-gray-500 hover:text-gray-700">← Volver a tareas</a>
        <button 
          id="saveBtn"
          class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-medium flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
          </svg>
          Guardar Cambios
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Contenido Principal -->
      <div class="lg:col-span-2 space-y-4">
        {/* Título */}
        <div>
          <input 
            type="text" 
            id="taskTitle"
            value={taskData.title}
            class="text-3xl font-bold w-full px-3 py-2 rounded-lg editable-input"
            placeholder="Título de la tarea"
          />
        </div>

        {/* Estado y Prioridad en fila */}
        <div class="flex gap-3">
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-600 mb-1">Estado</label>
            <select 
              id="taskStatus"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg"
            >
              {statusOptions.map((option: any) => (
                <option value={option.id} selected={option.id === (taskData.status || statusOptions[0].id)} class={`bg-[${option.color}] text-[${option.color}]`}>
                  {option.icon || ""}{option.name}
                </option>
              ))}
            </select>
          </div>
          
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-600 mb-1">Prioridad</label>
            <select 
              id="taskPriority"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg"
            >
              <option value="low" selected={taskData.priority === 'low'}>⬇️ Baja</option>
              <option value="medium" selected={taskData.priority === 'medium'}>➡️ Media</option>
              <option value="high" selected={taskData.priority === 'high'}>⬆️ Alta</option>
              <option value="critical" selected={taskData.priority === 'critical'}>🔥 Crítica</option>
            </select>
          </div>
        </div>

        {parentTask && (
          <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
            <p class="text-sm text-blue-900">
              <strong>Subtarea de:</strong> 
              <a href={`/tasks/${parentTask.id}`} class="underline hover:text-blue-700">
                {parentTask.data.title}
              </a>
            </p>
          </div>
        )}

        {/* Descripción */}
        <div class="section-card">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-gray-900 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
              </svg>
              Descripción
            </h3>
          </div>
          <textarea 
            id="taskDescription"
            rows="6"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg editable-input font-mono text-sm"
            placeholder="Añade una descripción más detallada..."
          >{taskData.description || ''}</textarea>
          <p class="text-xs text-gray-500 mt-2">Soporta Markdown</p>
        </div>

        {/* Categoría y Entradas Relacionadas */}
        {relatedCategory && (
          <div class="section-card">
            <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              Entradas Relacionadas
            </h3>
            
            <div class="flex items-center gap-2 mb-3 p-3 bg-gray-50 rounded-lg">
              <div class="w-6 h-6 rounded" style={`background-color: ${(relatedCategory as any).color}`}></div>
              <span class="font-medium">{(relatedCategory as any).name}</span>
            </div>

            <label class="flex items-center gap-2 mb-3">
              <input 
                type="checkbox" 
                id="taskAppliesToAll"
                checked={taskData.applies_to_all}
                class="rounded"
              />
              <span class="text-sm text-gray-700 font-medium">✨ Aplicar a TODAS las entradas de esta categoría</span>
            </label>

            {!taskData.applies_to_all && categoryEntries.length > 0 && (
              <div id="specificEntriesSection">
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  Entradas específicas seleccionadas:
                </label>
                <div class="max-h-64 overflow-y-auto border border-gray-200 rounded-lg divide-y divide-gray-200">
                  {categoryEntries.map((entry: any) => {
                    const isSelected = taskData.specific_entry_ids && taskData.specific_entry_ids.includes(entry.id);
                    return (
                      <label class="flex items-center gap-3 p-3 hover:bg-gray-50 cursor-pointer">
                        <input 
                          type="checkbox" 
                          class="entry-checkbox rounded" 
                          value={entry.id}
                          checked={isSelected}
                        />
                        <div class="flex-1">
                          <span class="text-sm text-gray-900">{entry.title}</span>
                        </div>
                        {isSelected && (
                          <span class="text-xs px-2 py-1 bg-indigo-100 text-indigo-700 rounded-full">
                            Vinculada
                          </span>
                        )}
                      </label>
                    );
                  })}
                </div>
                <p class="text-xs text-gray-500 mt-2">
                  {taskData.specific_entry_ids ? taskData.specific_entry_ids.length : 0} entrada(s) seleccionada(s)
                </p>
              </div>
            )}

            {!taskData.applies_to_all && categoryEntries.length === 0 && (
              <p class="text-sm text-gray-500 italic">No hay entradas en esta categoría</p>
            )}
          </div>
        )}

        {/* Subtareas */}
        {subtasks.length > 0 && (
          <div class="section-card">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-semibold text-gray-900 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                Subtareas ({subtasks.length})
              </h3>
              <a 
                href={`/tasks/create?parent_id=${id}&category_id=${taskData.related_category_id || ''}`}
                class="text-sm px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200"
              >
                + Añadir
              </a>
            </div>
            <div class="space-y-2">
              {subtasks.map((subtask: any) => {
                const subData = JSON.parse(subtask.data);
                const statusColors = {
                  todo: 'bg-gray-100 text-gray-700',
                  in_progress: 'bg-blue-100 text-blue-700',
                  done: 'bg-green-100 text-green-700',
                  blocked: 'bg-red-100 text-red-700'
                };
                return (
                  <a 
                    href={`/tasks/${subtask.id}`}
                    class="block p-3 border border-gray-200 rounded-lg hover:border-indigo-300 hover:bg-gray-50"
                  >
                    <div class="flex items-center justify-between">
                      <span class={subData.status === 'done' ? 'line-through text-gray-500' : ''}>
                        {subData.title}
                      </span>
                      <span class={`px-2 py-0.5 rounded text-xs font-medium ${statusColors[subData.status as keyof typeof statusColors] || 'bg-gray-100 text-gray-600'}`}>
                        {subData.status}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        {/* Botón Eliminar abajo */}
        <div class="pt-4">
          <button 
            id="deleteBtn"
            class="w-full px-4 py-3 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition font-medium border-2 border-red-200"
          >
            🗑️ Eliminar Tarea y Todas sus Subtareas
          </button>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-4">
        {/* Persona Asignada */}
        <div class="section-card">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Asignado a
          </label>
          <input 
            type="text" 
            id="taskAssignedTo"
            value={taskData.assigned_to || ''}
            class="w-full px-3 py-2 border border-gray-300 rounded-lg"
            placeholder="Nombre de la persona"
          />
        </div>

        {/* Fecha Límite */}
        <div class="section-card">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Fecha Límite
          </label>
          <input 
            type="date" 
            id="taskDueDate"
            value={taskData.due_date || ''}
            class="w-full px-3 py-2 border border-gray-300 rounded-lg"
          />
        </div>

        {/* Categoría Relacionada */}
        <div class="section-card">
          <label class="block text-sm font-medium text-gray-700 mb-2">Categoría Relacionada</label>
          <select 
            id="taskRelatedCategory"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg mb-2"
          >
            <option value="">Ninguna</option>
            {categories.map((cat: any) => (
              <option value={cat.id} selected={cat.id === taskData.related_category_id}>
                {cat.name}
              </option>
            ))}
          </select>
          <p class="text-xs text-gray-500">
            Al cambiar la categoría, se actualizará la lista de entradas disponibles
          </p>
        </div>

        {/* Etiquetas */}
        <div class="section-card">
          <label class="block text-sm font-medium text-gray-700 mb-2">Etiquetas</label>
          <div class="flex gap-2 mb-2">
            <input 
              type="text" 
              id="tagInput"
              placeholder="Nueva etiqueta"
              class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm"
            />
            <button 
              id="addTagBtn"
              class="px-3 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700"
            >
              +
            </button>
          </div>
          <div id="tagsList" class="flex flex-wrap gap-2">
            {taskData.tags && taskData.tags.map((tag: string) => (
              <span class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm flex items-center gap-2">
                #{tag}
                <button class="remove-tag hover:text-indigo-900" data-tag={tag}>×</button>
              </span>
            ))}
          </div>
        </div>

        {/* Información */}
        <div class="section-card">
          <h3 class="text-sm font-medium text-gray-700 mb-3">Información</h3>
          <dl class="space-y-2 text-sm">
            <div>
              <dt class="text-xs text-gray-500">ID</dt>
              <dd class="text-gray-900 font-mono text-xs">{id}</dd>
            </div>
            <div>
              <dt class="text-xs text-gray-500">Creada</dt>
              <dd class="text-gray-900">{new Date((task as any).created_at).toLocaleDateString('es-ES')}</dd>
            </div>
            <div>
              <dt class="text-xs text-gray-500">Última actualización</dt>
              <dd class="text-gray-900">{new Date((task as any).updated_at).toLocaleDateString('es-ES')}</dd>
            </div>
          </dl>
        </div>

        {/* Acciones Rápidas */}
        <div class="section-card">
          <h3 class="text-sm font-medium text-gray-700 mb-3">Acciones Rápidas</h3>
          <a 
            href={`/tasks/create?parent_id=${id}&category_id=${taskData.related_category_id || ''}`}
            class="block w-full px-4 py-2 bg-gray-100 text-gray-700 text-center rounded-lg hover:bg-gray-200 transition mb-2"
          >
            + Añadir Subtarea
          </a>
          <a 
            href={`/entries/${(relatedCategory as any)?.slug || ''}`}
            class="block w-full px-4 py-2 bg-gray-100 text-gray-700 text-center rounded-lg hover:bg-gray-200 transition"
          >
            Ver Categoría Relacionada
          </a>
        </div>
      </div>
    </div>
  </main>
</body>
</html>

<script define:vars={{ statusOptions }}>

    const taskId = document.body.dataset.taskId;

    // Cambio de categoría relacionada -> recargar entradas
    const categorySelect = document.getElementById('taskRelatedCategory');
    categorySelect?.addEventListener('change', async () => {
      const categoryId = categorySelect.value;
      
      if (!categoryId) {
        const section = document.getElementById('specificEntriesSection');
        if (section) section.innerHTML = '<p class="text-sm text-gray-500 italic">Selecciona una categoría primero</p>';
        return;
      }

      try {
        const response = await fetch(`/api/entries?category_id=${categoryId}`);
        const entries = await response.json();
        
        const section = document.getElementById('specificEntriesSection');
        if (!section) return;
        
        if (entries.length === 0) {
          section.innerHTML = '<p class="text-sm text-gray-500 italic">No hay entradas en esta categoría</p>';
        } else {
          section.innerHTML = `
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Entradas específicas:
            </label>
            <div class="max-h-64 overflow-y-auto border border-gray-200 rounded-lg divide-y divide-gray-200">
              ${entries.map((entry) => `
                <label class="flex items-center gap-3 p-3 hover:bg-gray-50 cursor-pointer">
                  <input type="checkbox" class="entry-checkbox rounded" value="${entry.id}" />
                  <div class="flex-1">
                    <span class="text-sm text-gray-900">${entry.title}</span>
                  </div>
                </label>
              `).join('')}
            </div>
          `;
        }
      } catch (error) {
        console.error('Error loading entries:', error);
      }
    });

    // Toggle applies_to_all
    const appliesToAll = document.getElementById('taskAppliesToAll');
    appliesToAll?.addEventListener('change', () => {
      const section = document.getElementById('specificEntriesSection');
      if (section) {
        section.style.display = appliesToAll.checked ? 'none' : 'block';
      }
    });

    // Guardar cambios
    document.getElementById('saveBtn').addEventListener('click', async () => {
      const selectedEntries = Array.from(document.querySelectorAll('.entry-checkbox:checked'))
        .map(cb => cb.value);
      
      console.log('Selected Entries:', selectedEntries);

      const updatedData = {
        title: (document.getElementById('taskTitle')).value,
        description: (document.getElementById('taskDescription')).value,
        status: (document.getElementById('taskStatus')).value,
        priority: (document.getElementById('taskPriority')).value,
        assigned_to: (document.getElementById('taskAssignedTo')).value,
        due_date: (document.getElementById('taskDueDate')).value || null,
        related_category_id: (document.getElementById('taskRelatedCategory')).value || null,
        applies_to_all: appliesToAll.checked,
        specific_entry_ids: appliesToAll.checked ? [] : selectedEntries
      };

      try {
        const response = await fetch('/api/tasks', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: taskId, ...updatedData })
        });

        if (response.ok) {
          // Mostrar feedback visual
          const btn = document.getElementById('saveBtn');
          btn.textContent = '✅ Guardado';
          btn.classList.add('bg-green-600');
          btn.classList.remove('bg-indigo-600');
          
          setTimeout(() => {
            window.location.reload();
          }, 1000);
        } else {
          alert('Error al guardar');
        }
      } catch (error) {
        alert('Error de red');
      }
    });

    // Eliminar tarea
    document.getElementById('deleteBtn')?.addEventListener('click', async () => {
      if (!confirm('¿Eliminar esta tarea y todas sus subtareas?')) return;

      try {
        const response = await fetch('/api/tasks', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: taskId })
        });

        if (response.ok) {
          window.location.href = '/tasks';
        }
      } catch (error) {
        alert('Error al eliminar');
      }
    });
  </script>