// src/pages/tasks/table.astro
import { db } from '@/lib/db';

const taskCategory = db!.prepare('SELECT * FROM categories WHERE slug = ?').get('task') as any;
const categories = db!.prepare('SELECT id, name FROM categories WHERE is_system = 0 ORDER BY name').all();

const statuses = db!.prepare('SELECT * FROM task_statuses ORDER BY order_index').all();

let tasks: any[] = [];
if (taskCategory) {
  const rawTasks = db!.prepare(`
    SELECT * FROM entries 
    WHERE category_id = ? 
      AND (json_extract(data, '$.parent_task_id') IS NULL OR json_extract(data, '$.parent_task_id') = '')
    ORDER BY created_at DESC
  `).all(taskCategory.id) as any[];
  
  tasks = rawTasks.map(task => {
    const data = JSON.parse(task.data);
    
    // Contar subtareas
    const subtaskCount = db!.prepare(`
      SELECT COUNT(*) as count FROM entries 
      WHERE category_id = ? AND json_extract(data, '$.parent_task_id') = ?
    `).get(taskCategory.id, task.id) as any;
    
    return {
      ...task,
      data,
      subtask_count: subtaskCount.count
    };
  });
}

if (statuses) {
  tasks = tasks.map(task => {

    const statusData = statuses.find(status => (status as any).id === task.data.status);

    return {
      ...task,
      statusData
    };
  });
}

console.log(tasks);
