---
// src/pages/tasks/table.astro
import { db } from '../../lib/db';

const taskCategory = db.prepare('SELECT * FROM categories WHERE slug = ?').get('task') as any;
const categories = db.prepare('SELECT id, name FROM categories WHERE is_system = 0 ORDER BY name').all();

let tasks: any[] = [];
if (taskCategory) {
  const rawTasks = db.prepare(`
    SELECT * FROM entries 
    WHERE category_id = ? 
      AND (json_extract(data, '$.parent_task_id') IS NULL OR json_extract(data, '$.parent_task_id') = '')
    ORDER BY created_at DESC
  `).all(taskCategory.id) as any[];
  
  tasks = rawTasks.map(task => {
    const data = JSON.parse(task.data);
    
    // Contar subtareas
    const subtaskCount = db.prepare(`
      SELECT COUNT(*) as count FROM entries 
      WHERE category_id = ? AND json_extract(data, '$.parent_task_id') = ?
    `).get(taskCategory.id, task.id) as any;
    
    return {
      ...task,
      data,
      subtask_count: subtaskCount.count
    };
  });
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tareas - Vista Tabla</title>
  <style>
    .task-row.collapsed .subtask-row { display: none; }
    .subtask-row { background-color: #f9fafb; }
    .expand-icon { transition: transform 0.2s; }
    .expand-icon.rotate-90 { transform: rotate(90deg); }
    .sort-icon { transition: all 0.2s; opacity: 0.3; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex items-center justify-between">
        <div>
          <a href="/" class="text-sm text-gray-500 hover:text-gray-700">← Dashboard</a>
          <h1 class="text-2xl font-bold text-gray-900 mt-1">📊 Vista Tabla</h1>
        </div>
        <div class="flex gap-2">
          <a href="/tasks" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
            Vista Lista
          </a>
          <a href="/tasks/create" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
            + Nueva Tarea
          </a>
          <a href="/tasks/statuses" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
            ⚙️ Configurar Estados
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-full px-4 sm:px-6 lg:px-8 py-8">
    <!-- Filtros Avanzados -->
    <div class="bg-white rounded-lg shadow border border-gray-200 p-4 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-gray-900">Filtros</h2>
        <button id="clearFilters" class="text-sm text-gray-500 hover:text-gray-700">Limpiar filtros</button>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Búsqueda texto -->
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Buscar</label>
          <input 
            type="text" 
            id="searchText"
            placeholder="Buscar en título..."
            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
          />
        </div>

        <!-- Prioridad -->
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Prioridad</label>
          <select id="filterPriority" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Todas</option>
            <option value="low">⬇️ Baja</option>
            <option value="medium">➡️ Media</option>
            <option value="high">⬆️ Alta</option>
            <option value="critical">🔥 Crítica</option>
          </select>
        </div>

        <!-- Categoría -->
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Categoría</label>
          <select id="filterCategory" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Todas</option>
            {categories.map((cat: any) => (
              <option value={cat.id}>{cat.name}</option>
            ))}
          </select>
        </div>

        <!-- Estado -->
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Estado</label>
          <select id="filterStatus" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Todos</option>
            <option value="pending">Pendiente</option>
            <option value="completed">Completado</option>
          </select>
        </div>
      </div>

      <!-- Query personalizada -->
      <div class="mt-4">
        <label class="block text-xs font-medium text-gray-600 mb-1">
          Query personalizada (JSON path)
        </label>
        <div class="flex gap-2">
          <input 
            type="text" 
            id="customQuery"
            placeholder="Ej: $.tags[0] = 'urgent'"
            class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono"
          />
          <button id="applyQuery" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm">
            Aplicar
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-1">
          Ejemplos: <code>$.due_date</code>, <code>$.tags[*]</code>, <code>$.applies_to_all = true</code>
        </p>
      </div>
    </div>

    <!-- Tabla -->
    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase w-8"></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase w-12">
                <input type="checkbox" id="selectAll" class="rounded" />
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-100 transition" data-sort="title">
                <div class="flex items-center gap-2">
                  Tarea
                  <svg class="w-4 h-4 sort-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                  </svg>
                </div>
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                Estado
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-100 transition" data-sort="priority">
                <div class="flex items-center gap-2">
                  Prioridad
                  <svg class="w-4 h-4 sort-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                  </svg>
                </div>
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                Categoría
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                Asignado
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-100 transition" data-sort="due_date">
                <div class="flex items-center gap-2">
                  Fecha Límite
                  <svg class="w-4 h-4 sort-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                  </svg>
                </div>
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                Etiquetas
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase w-24">
                Acciones
              </th>
            </tr>
          </thead>
          <tbody id="taskTableBody" class="divide-y divide-gray-200">
            {tasks.map((task: any) => {
              const categoryName = task.data.related_category_id ? 
                (() => {
                  const cat = categories.find((c: any) => c.id === task.data.related_category_id);
                  return cat ? (cat as any).name : '-';
                })() : '-';
                const statusIcons = {
                  todo: '📝',
                  in_progress: '🔄',
                  done: '✅',
                  blocked: '🚫'
                };
                const status = task.data.status || 'todo';
              
              return (
                <tr 
                  class="task-row hover:bg-gray-50 transition bg-white font-medium border-l-4 border-indigo-500"
                  data-task-id={task.id}
                  data-parent-id={task.data.parent_task_id || ''}
                  data-priority={task.data.priority}
                  data-category-id={task.data.related_category_id || ''}
                  data-status={status}
                  data-title={task.data.title.toLowerCase()}
                  data-due-date={task.data.due_date || ''}
                  data-assigned={task.data.assigned_to || ''}
                >
                  {/* Botón expandir */}
                  <td class="px-6 py-4 w-12">
                    {task.subtask_count > 0 ? (
                      <button 
                        class="expand-btn text-gray-400 hover:text-indigo-600 transition focus:outline-none"
                        data-task-id={task.id}
                        title={`Ver ${task.subtask_count} subtarea${task.subtask_count !== 1 ? 's' : ''}`}
                      >
                        <svg class="w-5 h-5 expand-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                        <span class="absolute -top-1 -right-1 w-4 h-4 bg-indigo-600 text-white text-xs rounded-full flex items-center justify-center">
                          {task.subtask_count}
                        </span>
                      </button>
                    ) : (
                      <div class="w-5 h-5"></div>
                    )}
                  </td>
                  
                  <td class="px-6 py-4">
                    <input type="checkbox" class="task-select rounded" data-task-id={task.id} />
                  </td>
                  
                  <td class="px-6 py-4">
                      <a 
                        href={`/tasks/${task.id}`} 
                        class="font-semibold text-gray-900 hover:text-indigo-600 transition"
                      >
                        {task.data.title}
                      </a>
                      {categoryName !== '-' && (
                        <div class="text-xs text-gray-500 mt-1">
                          📁 {categoryName}
                          {task.data.applies_to_all && <span class="ml-2 text-purple-600">• Todas las entradas</span>}
                          {task.data.specific_entry_ids?.length > 0 && (
                            <span class="ml-2 text-blue-600">• {task.data.specific_entry_ids.length} específica(s)</span>
                          )}
                        </div>
                      )}
                  </td>

                  <td class="px-6 py-4">
                    <span class={`px-2 py-1 rounded text-xs font-medium`}>
                      {statusIcons[status as keyof typeof statusIcons]} {status}
                    </span>
                  </td>
                  
                  <td class="px-6 py-4">
                    <span class={`px-2.5 py-1 rounded text-xs font-medium ${
                      task.data.priority === 'critical' ? 'bg-red-100 text-red-700' :
                      task.data.priority === 'high' ? 'bg-orange-100 text-orange-700' :
                      task.data.priority === 'medium' ? 'bg-blue-100 text-blue-700' :
                      'bg-gray-100 text-gray-600'
                    }`}>
                      {task.data.priority}
                    </span>
                  </td>
                  
                  <td class="px-6 py-4 text-sm text-gray-500">
                    {categoryName}
                  </td>

                  <td class="px-6 py-4 text-sm text-gray-500">
                    {task.data.assigned_to || '-'}
                  </td>
                  
                  <td class="px-6 py-4 text-sm text-gray-500">
                    {task.data.due_date ? new Date(task.data.due_date).toLocaleDateString('es-ES') : '-'}
                  </td>
                  
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1">
                      {task.data.tags?.slice(0, 2).map((tag: string) => (
                        <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs">
                          #{tag}
                        </span>
                      ))}
                      {task.data.tags?.length > 2 && (
                        <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs">
                          +{task.data.tags.length - 2}
                        </span>
                      )}
                    </div>
                  </td>
                  
                  <td class="px-6 py-4">
                    <button class="delete-task text-red-600 hover:text-red-800 text-sm font-medium" data-task-id={task.id}>
                      Eliminar
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
        <span class="text-sm text-gray-500">
          <span id="visibleCount">{tasks.length}</span> de {tasks.length} tareas
        </span>
        <div class="flex gap-2">
          <button id="bulkComplete" class="px-3 py-1 bg-green-100 text-green-700 rounded hover:bg-green-200 text-sm" disabled>
            Completar seleccionadas
          </button>
          <button id="bulkDelete" class="px-3 py-1 bg-red-100 text-red-700 rounded hover:bg-red-200 text-sm" disabled>
            Eliminar seleccionadas
          </button>
        </div>
      </div>
    </div>
  </main>

  <style>
  /* Mejora visual: diferenciación clara */
  .task-row {
    transition: all 0.15s ease;
  }
  
  .task-row:hover {
    background-color: #f9fafb;
  }
  
  /* Tareas principales: más destacadas */
  .task-row:not([data-parent-id]) {
    font-weight: 500;
    border-left: 3px solid #6366f1; /* Barra indigo */
  }
  
  /* Subtareas: indentadas y con fondo diferente */
  .subtask-row {
    background-color: linear-gradient(to right, #f9fafb 0%, #ffffff 100%);
    border-left: 3px solid #cbd5e1; /* Barra gris */
    transition: max-height 0.3s ease, opacity 0.3s ease;
  }
  
  .subtask-row:hover {
    background-color: linear-gradient(to right, #f1f5f9 0%, #f9fafb 100%);
  }

  .expand-btn {
    position: relative;
  }

  .expand-btn span {
    font-size: 9px;
    line-height: 1;
  }
  
  /* Icono de expansión suave */
  .expand-icon {
    transition: transform 0.2s ease;
  }
  
  .expand-icon.rotate-90 {
    transform: rotate(90deg);
  }
  
  /* Iconos de ordenamiento */
  .sort-icon {
    transition: all 0.2s ease;
    opacity: 0.3;
  }
  
  th[data-sort] {
    user-select: none;
    cursor: pointer;
  }
  
  th[data-sort]:hover .sort-icon {
    opacity: 0.6;
  }
  
  /* Badges de categoría más visibles */
  .category-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    background-color: #ede9fe;
    color: #6d28d9;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
  }
  
  /* Completadas: menos prominentes */
  .task-row[data-completed="true"] {
    opacity: 0.6;
  }
  
  .task-row[data-completed="true"] a {
    text-decoration: line-through;
  }
</style>

  <script>
    let allTasks: any[] = [];
    let filteredTasks: any[] = [];
    let currentSort = { field: null as string | null, direction: null as 'asc' | 'desc' | null };
    const expandedTasks = new Set<string>();

    document.addEventListener('DOMContentLoaded', () => {
      const rows = document.querySelectorAll('.task-row');
      allTasks = Array.from(rows).map(row => ({
        element: row,
        id: (row as HTMLElement).dataset.taskId,
        parentId: (row as HTMLElement).dataset.parentId,
        priority: (row as HTMLElement).dataset.priority,
        categoryId: (row as HTMLElement).dataset.categoryId,
        completed: (row as HTMLElement).dataset.completed === 'true',
        title: (row as HTMLElement).dataset.title,
        dueDate: (row as HTMLElement).dataset.dueDate
      }));
      filteredTasks = [...allTasks];
    });

    // ORDENAMIENTO CORREGIDO
    function sortTasks() {
      if (!currentSort.direction || !currentSort.field) {
        // Sin orden: restaurar orden original del DOM
        const tbody = document.getElementById('taskTableBody')!;
        allTasks.forEach(task => tbody.appendChild(task.element));
        return;
      }

      const tbody = document.getElementById('taskTableBody')!;
      
      // Ordenar solo tareas principales (sin parentId)
      const mainTasks = filteredTasks.filter(t => !t.parentId);
      
      mainTasks.sort((a, b) => {
        let aVal: any, bVal: any;
        
        if (currentSort.field === 'title') {
          aVal = a.title;
          bVal = b.title;
        } else if (currentSort.field === 'priority') {
          const priorityOrder = { low: 1, medium: 2, high: 3, critical: 4 };
          aVal = priorityOrder[a.priority as keyof typeof priorityOrder] || 0;
          bVal = priorityOrder[b.priority as keyof typeof priorityOrder] || 0;
        } else if (currentSort.field === 'due_date') {
          aVal = a.dueDate || '9999-12-31';
          bVal = b.dueDate || '9999-12-31';
        }
        
        const comparison = aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
        return currentSort.direction === 'asc' ? comparison : -comparison;
      });
      
      // Reordenar DOM manteniendo subtareas debajo de sus padres
      mainTasks.forEach(mainTask => {
        tbody.appendChild(mainTask.element);
        
        // Insertar subtareas inmediatamente después
        const subtasks = allTasks.filter(t => t.parentId === mainTask.id);
        subtasks.forEach(sub => tbody.appendChild(sub.element));
      });
    }

    // HEADERS CON ORDENAMIENTO CÍCLICO
    document.querySelectorAll('[data-sort]').forEach(header => {
      header.addEventListener('click', () => {
        const sortBy = (header as HTMLElement).dataset.sort!;
        const icon = header.querySelector('.sort-icon');
        
        // Resetear otros headers
        document.querySelectorAll('[data-sort]').forEach(h => {
          if (h !== header) {
            const otherIcon = h.querySelector('.sort-icon');
            if (otherIcon) {
              (otherIcon as HTMLElement).style.opacity = '0.3';
              (otherIcon as HTMLElement).style.transform = 'none';
            }
          }
        });
        
        // Ciclar: null → asc → desc → null
        if (currentSort.field === sortBy) {
          if (currentSort.direction === null) {
            currentSort.direction = 'asc';
          } else if (currentSort.direction === 'asc') {
            currentSort.direction = 'desc';
          } else {
            currentSort.direction = null;
            currentSort.field = null;
          }
        } else {
          currentSort.field = sortBy;
          currentSort.direction = 'asc';
        }
        
        // Actualizar icono visual
        if (currentSort.direction === null) {
          (icon as HTMLElement).style.opacity = '0.3';
          (icon as HTMLElement).style.transform = 'none';
        } else if (currentSort.direction === 'asc') {
          (icon as HTMLElement).style.opacity = '1';
          (icon as HTMLElement).style.transform = 'none';
        } else {
          (icon as HTMLElement).style.opacity = '1';
          (icon as HTMLElement).style.transform = 'rotate(180deg)';
        }
        
        sortTasks();
      });
    });

    document.querySelectorAll('.expand-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const taskId = (btn as HTMLElement).dataset.taskId!;
        const icon = btn.querySelector('.expand-icon');
        const row = btn.closest('tr')!;
        
        const isExpanded = expandedTasks.has(taskId);
        
        if (isExpanded) {
          // Colapsar
          expandedTasks.delete(taskId);
          icon?.classList.remove('rotate-90');
          
          const subtasks = document.querySelectorAll(`[data-parent-id="${taskId}"]`);
          subtasks.forEach(sub => {
            (sub as HTMLElement).style.maxHeight = '0';
            (sub as HTMLElement).style.opacity = '0';
            setTimeout(() => (sub as HTMLElement).remove(), 300);
          });
          
        } else {
          // Expandir
          expandedTasks.add(taskId);
          icon?.classList.add('rotate-90');
          
          // Mostrar loading
          const loadingRow = document.createElement('tr');
          loadingRow.className = 'subtask-loading bg-gray-50';
          loadingRow.innerHTML = `
            <td colspan="8" class="px-6 py-3 text-center text-sm text-gray-500">
              <svg class="animate-spin w-4 h-4 inline-block mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Cargando subtareas...
            </td>
          `;
          row.after(loadingRow);
          
          try {
            const response = await fetch(`/api/tasks?parent_id=${taskId}`);
            const subtasks = await response.json();
            
            loadingRow.remove();
            
            if (subtasks.length === 0) {
              // Esto no debería pasar si el contador es correcto
              const emptyRow = document.createElement('tr');
              emptyRow.className = 'subtask-row bg-gray-50';
              emptyRow.dataset.parentId = taskId;
              emptyRow.innerHTML = `
                <td colspan="8" class="px-6 py-3 text-center text-sm text-gray-500 italic">
                  No hay subtareas
                </td>
              `;
              row.after(emptyRow);
            } else {
              let insertAfter = row;
              subtasks.forEach((subtask: any, index: number) => {
                const subRow = createSubtaskRow(subtask, taskId, index);
                insertAfter.after(subRow);
                insertAfter = subRow;
                
                setTimeout(() => {
                  subRow.style.maxHeight = '100px';
                  subRow.style.opacity = '1';
                }, index * 50);
              });
            }
          } catch (error) {
            console.error('Error loading subtasks:', error);
            loadingRow.innerHTML = `
              <td colspan="8" class="px-6 py-3 text-center text-sm text-red-600">
                Error al cargar subtareas
              </td>
            `;
          }
        }
      });
    });

function createSubtaskRow(subtask: any, parentId: string, index: number): HTMLTableRowElement {
  const row = document.createElement('tr');
  row.className = 'subtask-row transition-all duration-300';
  row.dataset.parentId = parentId;
  row.dataset.taskId = subtask.id;
  row.style.maxHeight = '0';
  row.style.opacity = '0';
  row.style.overflow = 'hidden';
  
  const priorityColors = {
    low: 'bg-gray-100 text-gray-700',
    medium: 'bg-blue-100 text-blue-700',
    high: 'bg-orange-100 text-orange-700',
    critical: 'bg-red-100 text-red-700'
  };

  console.log(subtask)

  if (subtask.subtasks.length > 0) {
  const texttoAdd = "Ver " + subtask.subtasks.length.toString() + " subtarea"+(subtask.subtasks.length !== 1 ? 's' : '')
  
  row.innerHTML = `<td class="px-6 py-4 w-12">
        <button 
          class="expand-btn text-gray-400 hover:text-indigo-600 transition focus:outline-none relative"
          data-task-id=${subtask.id}
          title=${texttoAdd}
        >
          <svg class="w-5 h-5 expand-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="absolute -top-1 -right-1 w-4 h-4 bg-indigo-600 text-white text-xs rounded-full flex items-center justify-center">
            ${subtask.subtasks.length}
          </span>
        </button>
        </td>`;
  } else {
    row.innerHTML = `<td class="px-6 py-4 w-12"><div class="w-5 h-5"></div></td>`;
  }
                    
  row.innerHTML += `
    <td class="px-6 py-3">
      <input type="checkbox" class="task-select rounded" data-task-id="${subtask.id}" />
    </td>
    <td class="px-6 py-3">
      <div class="flex items-center gap-3 pl-8">
        <span class="text-indigo-400 font-bold">└─${'─'.repeat(Math.min(subtask.level-1, 4))}</span>
        <a href="/tasks/${subtask.id}" class="text-sm text-gray-700 hover:text-indigo-600">
          ${subtask.data.title}
        </a>
      </div>
    </td>
    <td class="px-6 py-4">
      <span class='px-2 py-1 rounded text-xs font-medium'>
        ${subtask.data.status}
      </span>
    </td>
    <td class="px-6 py-3">
      <span class="px-2 py-1 rounded text-xs font-medium ${priorityColors[subtask.data.priority as keyof typeof priorityColors]}">
        ${subtask.data.priority}
      </span>
    </td>
    <td class="px-6 py-3 text-sm text-gray-500">-</td>
    <td class="px-6 py-4 text-sm text-gray-500">
      ${subtask.data.assigned_to || '-'}
    </td>
    <td class="px-6 py-3 text-sm text-gray-500">
      ${subtask.data.due_date ? new Date(subtask.data.due_date).toLocaleDateString('es-ES') : '-'}
    </td>
    <td class="px-6 py-3">
      ${subtask.data.tags?.slice(0, 2).map((tag: string) => `
        <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs">#${tag}</span>
      `).join('') || ''}
    </td>
    <td class="px-6 py-3">
      <button class="delete-task text-red-600 hover:text-red-800 text-sm" data-task-id="${subtask.id}">
        Eliminar
      </button>
    </td>
  `;
  
  return row;
}
  </script>
</body>
</html>