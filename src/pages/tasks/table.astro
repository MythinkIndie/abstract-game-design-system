    font-size: 0.75rem;
    font-weight: 500;
  }
  
  /* Completadas: menos prominentes */
  .task-row[data-completed="true"] {
    opacity: 0.6;
  }
  
  .task-row[data-completed="true"] a {
    text-decoration: line-through;
  }
</style>

  <script>
    let allTasks: any[] = [];
    let filteredTasks: any[] = [];
    let currentSort = { field: null as string | null, direction: null as 'asc' | 'desc' | null };
    const expandedTasks = new Set<string>();

    document.addEventListener('DOMContentLoaded', () => {
      const rows = document.querySelectorAll('.task-row');
      allTasks = Array.from(rows).map(row => ({
        element: row,
        id: (row as HTMLElement).dataset.taskId,
        parentId: (row as HTMLElement).dataset.parentId,
        priority: (row as HTMLElement).dataset.priority,
        categoryId: (row as HTMLElement).dataset.categoryId,
        status: (row as HTMLElement).dataset.status,
        title: (row as HTMLElement).dataset.title,
        dueDate: (row as HTMLElement).dataset.dueDate,
        assigned: (row as HTMLElement).dataset.assigned
      }));
      filteredTasks = [...allTasks];
    });

    const searchText = document.getElementById('searchText') as HTMLInputElement;
    const filterStatus = document.getElementById('filterStatus') as HTMLSelectElement;
    const filterPriority = document.getElementById('filterPriority') as HTMLSelectElement;
    const filterCategory = document.getElementById('filterCategory') as HTMLSelectElement;
    const filterAssigned = document.getElementById('filterAssigned') as HTMLInputElement;

     function applyFilters() {
      const search = searchText?.value.toLowerCase() || '';
      const status = filterStatus?.value || '';
      const priority = filterPriority?.value || '';
      const category = filterCategory?.value || '';
      const assigned = filterAssigned?.value.toLowerCase() || '';

      filteredTasks = allTasks.filter(task => {
        const matchesSearch = !search || task.title.includes(search);
        const matchesStatus = !status || task.status === status;
        const matchesPriority = !priority || task.priority === priority;
        const matchesCategory = !category || task.categoryId === category;
        const matchesAssigned = !assigned || task.assigned.toLowerCase().includes(assigned);

        return matchesSearch && matchesStatus && matchesPriority && matchesCategory && matchesAssigned;
      });

      updateTable();
    }

    function updateTable() {
      allTasks.forEach(task => {
        (task.element as HTMLElement).style.display = 
          filteredTasks.includes(task) ? '' : 'none';
      });

      document.getElementById('visibleCount')!.textContent = String(filteredTasks.length);
    }

    searchText?.addEventListener('input', applyFilters);
    filterStatus?.addEventListener('change', applyFilters);
    filterPriority?.addEventListener('change', applyFilters);
    filterCategory?.addEventListener('change', applyFilters);
    filterAssigned?.addEventListener('input', applyFilters);

    document.getElementById('clearFilters')?.addEventListener('click', () => {
      if (searchText) searchText.value = '';
      if (filterStatus) filterStatus.value = '';
      if (filterPriority) filterPriority.value = '';
      if (filterCategory) filterCategory.value = '';
      if (filterAssigned) filterAssigned.value = '';
      applyFilters();
    });

    document.querySelectorAll('.expand-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const taskId = (btn as HTMLElement).dataset.taskId!;
        const icon = btn.querySelector('.expand-icon');
        const row = btn.closest('tr')!;
        
        const isExpanded = expandedTasks.has(taskId);
        if (isExpanded) {
          // Colapsar
          hideSubtasksRecursive(taskId);
          
          icon?.classList.remove('rotate-90');
          expandedTasks.delete(taskId);
          
        } else {
          // Expandir
          icon?.classList.add('rotate-90');
          expandedTasks.add(taskId);

          // Buscar si ya existen subtareas cargadas
          const existingSubtasks = document.querySelectorAll(`[data-parent-id="${taskId}"]`);
          
          if (existingSubtasks.length === 0) {
            // Cargar subtareas por primera vez
            await loadSubtasks(taskId, row!);
          } else {
            // Mostrar subtareas existentes
            existingSubtasks.forEach(sub => {
              (sub as HTMLElement).style.display = '';
            });
          }
        }
      });
    });

    function hideSubtasksRecursive(parentId: string) {
      const subtasks = document.querySelectorAll(`[data-parent-id="${parentId}"]`);
      console.log(subtasks)
      subtasks.forEach(sub => {

        (sub as HTMLElement).style.display = 'none';
        
        // Colapsar el icono si tiene
        const expandBtn = sub.querySelector('.expand-btn');
        const icon = expandBtn?.querySelector('.expand-icon');
        if (icon?.classList.contains('rotate-90')) {
          icon.classList.remove('rotate-90');
        }
        
        // Ocultar recursivamente las subtareas de esta subtarea
        const subTaskId = (sub as HTMLElement).dataset.taskId;
        if (subTaskId) {
          hideSubtasksRecursive(subTaskId);
        }
      });
    }

     async function loadSubtasks(parentId: string, parentRow: Element, level: number = 1) {
      try {
        const response = await fetch(`/api/tasks?parent_id=${parentId}`);
        const subtasks = await response.json();
        
        subtasks.forEach((subtask: any) => {
          const newRow = document.createElement('tr');
          const indentClass = `subtask-row bg-gray-50 border-l-4 border-indigo-${Math.min(200 + level * 100, 600)}`;
          newRow.className = indentClass;
          newRow.dataset.parentId = parentId;
          newRow.dataset.taskId = subtask.id;
          newRow.dataset.level = String(level);
          
          // Verificar si esta subtarea tiene subtareas
          const hasChildren = subtask.subtasks && subtask.subtasks.length > 0;
          
          newRow.innerHTML = `
            <td class="px-6 py-4">
              ${hasChildren ? `
                <button class="relative expand-btn text-gray-400 hover:text-gray-600 transition" data-task-id="${subtask.id}">
                  <svg class="w-4 h-4 expand-icon transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  <span class="absolute -top-2 -right-2 w-3 h-3 bg-indigo-600 text-white text-xs rounded-full flex items-center justify-center">
                    ${subtask.subtasks.length}
                  </span>
                </button>
              ` : ''}
            </td>
            <td class="px-6 py-4">
              <input type="checkbox" class="task-select rounded" data-task-id="${subtask.id}" />
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2" style="padding-left: ${level * 0.5}rem;">
                <span class="text-gray-400">${'└─'+'─'.repeat(Math.min(level - 1, 3))}</span>
                <a href="/tasks/${subtask.id}" class="text-gray-700 hover:text-indigo-600 ${subtask.statusData.name === 'Completado' ? 'line-through' : ''}">${subtask.data.title}</a>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 rounded text-xs font-medium gb-[${subtask.statusData.color}]">
                ${subtask.statusData.icon} ${subtask.statusData.name}
              </span>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 rounded text-xs font-medium ${
                subtask.data.priority === 'critical' ? 'bg-red-100 text-red-700' :
                subtask.data.priority === 'high' ? 'bg-orange-100 text-orange-700' :
                subtask.data.priority === 'medium' ? 'bg-blue-100 text-blue-700' :
                'bg-gray-100 text-gray-600'
              }">
                ${subtask.data.priority}
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">-</td>
            <td class="px-6 py-4 text-sm text-gray-500">${subtask.data.assigned_to || '-'}</td>
            <td class="px-6 py-4 text-sm text-gray-500">${subtask.data.due_date ? new Date(subtask.data.due_date).toLocaleDateString('es-ES') : '-'}</td>
            <td class="px-6 py-3">
              ${subtask.data.tags?.slice(0, 2).map((tag: string) => `
                <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs">#${tag}</span>
              `).join('') || ''}
            </td>
            <td class="px-6 py-4">
              <button class="delete-task text-red-600 hover:text-red-800 text-sm" data-task-id="${subtask.id}">Eliminar</button>
            </td>
          `;
          
          parentRow.after(newRow);
          
          // Añadir event listener al nuevo botón de expandir si existe
          if (hasChildren) {
            const newExpandBtn = newRow.querySelector('.expand-btn');
            newExpandBtn?.addEventListener('click', async (e) => {
              e.stopPropagation();
              const subTaskId = (newExpandBtn as HTMLElement).dataset.taskId!;
              const icon = newExpandBtn.querySelector('.expand-icon');
              
              const isExpanded = icon?.classList.contains('rotate-90');
              if (isExpanded) {
                icon?.classList.remove('rotate-90');
                hideSubtasksRecursive(subTaskId);
              } else {
                icon?.classList.add('rotate-90');
                
                const existingSubSubtasks = document.querySelectorAll(`[data-parent-id="${subTaskId}"]`);
                if (existingSubSubtasks.length === 0) {
                  await loadSubtasks(subTaskId, newRow, level + 1);
                } else {
                  existingSubSubtasks.forEach(sub => {
                    (sub as HTMLElement).style.display = '';
                  });
                }
              }
            });
          }
          
          // Actualizar allTasks
          allTasks.push({
            element: newRow,
            id: subtask.id,
            parentId: parentId,
            priority: subtask.data.priority,
            categoryId: '',
            status: subtask.statusData.id,
            title: subtask.data.title.toLowerCase(),
            dueDate: subtask.data.due_date || '',
            assigned: subtask.data.assigned_to || ''
          });
        });
      } catch (error) {
        console.error('Error loading subtasks:', error);
      }
    }
  </script>
</body>
</html>