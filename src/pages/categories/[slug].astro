---
// src/pages/categories/[slug].astro
import { getSupabaseClient } from "@/lib/supabaseClient";

const { slug } = Astro.params;

const supabase = getSupabaseClient();

const category = await supabase
  .from('categories')
  .select('*')
  .eq('slug', slug);

if (!category.data || category.data.length === 0) {
  return Astro.redirect('/categories');
}

const fields = await supabase
  .from('fields')
  .select('*')
  .eq('category_id', (category.data[0] as any).id)
  .order('field_order', { ascending: true })
  .order('created_at', { ascending: true });

const inheritedFields: any[] = [];

for (const f of fields.data!) {
  if ((category.data[0] as any).inherits_from) {
    const { data } = await supabase
      .from('fields')
      .select('id')
      .eq('category_id', (category.data[0] as any).inherits_from)
      .eq('name', f.name);

    if (data?.[0]?.id) {
      inheritedFields.push(f);
    }
  }
}

const customFields = fields.data.filter((f: any) => !inheritedFields.includes(f));

const entryCount = await supabase
  .from('entries')
  .select('id', { count: 'exact' })
  .eq('category_id', (category.data[0] as any).id);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{(category.data[0] as any).name} - Configuración</title>
</head>
<body class="bg-gray-50 min-h-screen" data-category-id={(category.data[0] as any).id} data-slug={slug}>
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <a href="/categories" class="text-sm text-gray-500 hover:text-gray-700">← Volver a categorías</a>
      <div class="flex items-center justify-between mt-2">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-lg flex items-center justify-center text-white font-bold text-2xl" style={`background-color: ${(category.data[0] as any).color}`}>
            {category.data && (category.data[0] as any).name?.substring(0, 2).toUpperCase()}
          </div>
          <div>
            <h1 class="text-2xl font-bold text-gray-900">{(category.data[0] as any).name}</h1>
            <p class="text-sm text-gray-500">{(category.data[0] as any).description || 'Sin descripción'}</p>
          </div>
        </div>
        <div class="flex gap-3">
          <a href={`/entries/${slug}`} class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition">
            Ver Entradas ({entryCount.data?.length})
          </a>
          <a href={`/entries/${slug}/create`} class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
            + Nueva Entrada
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="lg:col-span-2">
      <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Campos de la Categoría</h2>
          {!(category.data[0] as any).is_system && (
            <button 
              id="addFieldBtn"
              class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-sm font-medium"
            >
              + Añadir Campo
            </button>
          )}
        </div>

        <div class="p-6 space-y-8">
          {/* CAMPOS HEREDADOS */}
          {inheritedFields && inheritedFields.length > 0 && (
            <div>
              <div class="flex items-center gap-2 mb-4">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">
                  Campos Heredados de Entity
                </h3>
              </div>
              
              <div class="space-y-3 pl-6 border-l-2 border-gray-200">
                {inheritedFields && inheritedFields.map((field: any) => (
                  <div class="border border-gray-200 bg-gray-50 rounded-lg p-4">
                    <div class="flex items-start justify-between">
                      <div class="flex-1">
                        <div class="flex items-center gap-3 mb-2">
                          <h3 class="font-semibold text-gray-700">{field.label}</h3>
                          <span class="px-2 py-0.5 bg-gray-200 text-gray-600 text-xs font-medium rounded">
                            {field.type}
                          </span>
                          {field.required === 1 && (
                            <span class="px-2 py-0.5 bg-gray-200 text-gray-600 text-xs font-medium rounded">
                              Requerido
                            </span>
                          )}
                          <span class="px-2 py-0.5 bg-blue-100 text-blue-700 text-xs font-medium rounded">
                            🔗 Heredado
                          </span>
                        </div>
                        <p class="text-xs font-mono text-gray-500 mb-1">Campo: {field.name}</p>
                        {field.help_text && (
                          <p class="text-sm text-gray-600">{field.help_text}</p>
                        )}
                      </div>
                      {/* No se puede eliminar campos heredados */}
                      <div class="text-gray-400" title="Los campos heredados no se pueden eliminar">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* CAMPOS PERSONALIZADOS */}
          <div>
            <div class="flex items-center gap-2 mb-4">
              <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
              <h3 class="text-sm font-semibold text-indigo-900 uppercase tracking-wide">
                Campos Personalizados ({customFields ? customFields.length : 0})
              </h3>
            </div>

            {customFields && customFields.length === 0 ? (
              <div class="text-center py-8 border-2 border-dashed border-gray-300 rounded-lg">
                <p class="text-gray-500 mb-3">No hay campos personalizados aún</p>
                {!(category.data[0] as any).is_system && (
                  <button 
                    onclick="document.getElementById('addFieldBtn')?.click()"
                    class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-sm"
                  >
                    Añadir Primer Campo
                  </button>
                )}
              </div>
            ) : (
              <div class="space-y-3 pl-6 border-l-2 border-indigo-200">
                {customFields && customFields.map((field: any) => (
                  <div class="border border-gray-200 rounded-lg p-4 hover:border-indigo-300 transition bg-white">
                    <div class="flex items-start justify-between">
                      <div class="flex-1">
                        <div class="flex items-center gap-3 mb-2">
                          <h3 class="font-semibold text-gray-900">{field.label}</h3>
                          <span class="px-2 py-0.5 bg-indigo-100 text-indigo-700 text-xs font-medium rounded">
                            {field.type}
                          </span>
                          {field.required === 1 && (
                            <span class="px-2 py-0.5 bg-red-100 text-red-600 text-xs font-medium rounded">
                              Requerido
                            </span>
                          )}
                          {field.unique_value === 1 && (
                            <span class="px-2 py-0.5 bg-blue-100 text-blue-600 text-xs font-medium rounded">
                              Único
                            </span>
                          )}
                        </div>
                        <p class="text-xs font-mono text-gray-500 mb-1">Campo: {field.name}</p>
                        {field.help_text && (
                          <p class="text-sm text-gray-600">{field.help_text}</p>
                        )}
                        {field.config && field.config !== '{}' && (
                          <details class="mt-2">
                            <summary class="text-xs text-gray-500 cursor-pointer hover:text-gray-700">
                              Ver configuración
                            </summary>
                            <pre class="text-xs bg-gray-50 p-2 rounded mt-1 overflow-x-auto">{field.config}</pre>
                          </details>
                        )}
                      </div>
                      
                      {/* BOTÓN ELIMINAR (solo campos personalizados) */}
                      {!(category.data[0] as any).is_system && (
                        <button 
                          class="delete-field text-gray-400 hover:text-red-600 transition ml-4 group"
                          data-id={field.id}
                          data-name={field.label}
                          title="Eliminar campo"
                        >
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal para añadir campo (simplificado) -->
  <div id="fieldModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-900">Añadir Nuevo Campo</h3>
        <button id="closeModal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form id="fieldForm" class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Etiqueta *</label>
          <input type="text" id="fieldLabel" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Ej: Puntos de Vida" />
        </div>
        <div>
          <label for="fieldName" class="block text-sm font-medium text-gray-700 mb-2">Nombre del Campo (opcional)</label>
          <input type="text" id="fieldName" class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Se auto-genera desde la etiqueta" />
          <p class="text-xs text-gray-500 mt-1">Formato: snake_case (ej: health_points)</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Tipo *</label>
          <select id="fieldType" required class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            <option value="text">Texto</option>
            <option value="number">Número</option>
            <option value="boolean">Booleano (Sí/No)</option>
            <option value="markdown">Markdown</option>
            <option value="enum">Enumeración (opciones)</option>
            <option value="list">Lista</option>
            <option value="json">JSON</option>
            <option value="relation">Relación (FK a otra categoría)</option>
          </select>
        </div>
        <div id="relationConfig" class="hidden mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Categoría relacionada *
          </label>
          <select id="relationCategory" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
            <option value="">Selecciona una categoría...</option>
            <!-- Se llenará dinámicamente -->
          </select>
          
          <label class="flex items-center gap-2 mt-3">
            <input type="checkbox" id="relationMultiple" class="rounded" />
            <span class="text-sm text-gray-700">Permitir múltiples relaciones</span>
          </label>
          
          <p class="text-xs text-gray-600 mt-2">
            💡 Esto creará un selector para elegir entrada(s) de la categoría seleccionada
          </p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Texto de Ayuda</label>
          <input type="text" id="fieldHelp" class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Descripción del campo" />
        </div>
        <div class="flex gap-4">
          <label class="flex items-center gap-2">
            <input type="checkbox" id="fieldRequired" class="rounded" />
            <span class="text-sm text-gray-700">Campo requerido</span>
          </label>
          <label class="flex items-center gap-2">
            <input type="checkbox" id="fieldUnique" class="rounded" />
            <span class="text-sm text-gray-700">Valor único</span>
          </label>
        </div>
        <div class="flex gap-3 pt-4">
          <button type="submit" class="flex-1 px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-medium">
            Crear Campo
          </button>
          <button type="button" id="cancelField" class="px-6 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition font-medium">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const categoryId = document.body.dataset.categoryId;
    const slug = document.body.dataset.slug;
    
    const modal = document.getElementById('fieldModal');
    const addFieldBtn = document.getElementById('addFieldBtn');
    const closeModal = document.getElementById('closeModal');
    const cancelField = document.getElementById('cancelField');
    const fieldForm = document.getElementById('fieldForm');

    addFieldBtn?.addEventListener('click', () => {
      modal?.classList.remove('hidden');
    });

    [closeModal, cancelField].forEach(btn => {
      btn?.addEventListener('click', () => {
        modal?.classList.add('hidden');
      });
    });

    fieldForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Generar nombre automático si está vacío
      const labelValue = (document.getElementById('fieldLabel') as HTMLInputElement).value;
      let nameValue = (document.getElementById('fieldName') as HTMLInputElement).value;
      
      if (!nameValue && labelValue) {
        nameValue = labelValue.toLowerCase().replace(/[^a-z0-9]+/g, '_');
        (document.getElementById('fieldName') as HTMLInputElement).value = nameValue;
      }
      
      const data = {
        category_id: categoryId,
        name: nameValue,
        label: labelValue,
        type: (document.getElementById('fieldType') as HTMLSelectElement).value,
        help_text: (document.getElementById('fieldHelp') as HTMLInputElement).value,
        required: (document.getElementById('fieldRequired') as HTMLInputElement).checked,
        unique_value: (document.getElementById('fieldUnique') as HTMLInputElement).checked,
        config: {}
      };
      
      try {
        const response = await fetch('/api/fields', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        if (response.ok) {
          window.location.href = window.location.pathname;
        } else {
          const error = await response.json();
          alert('Error: ' + error.error);
        }
      } catch (error) {
        alert('Error al crear el campo');
      }
    });

    // Delete field
    document.querySelectorAll('.delete-field').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        const name = (btn as HTMLElement).dataset.name;
        
        const confirmed = confirm(
          `¿Eliminar el campo "${name}"?\n\n` +
          '⚠️ ADVERTENCIA: También se eliminarán todos los datos de este campo en las entradas existentes.'
        );
        
        if (!confirmed) return;
        
        try {
          const response = await fetch('/api/fields', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });
          
          if (response.ok) {
            // Animación de salida
            const fieldCard:HTMLElement|null = btn.closest('.border');
            if (fieldCard) {
              fieldCard.style.opacity = '0';
              fieldCard.style.transform = 'translateX(-20px)';
              fieldCard.style.transition = 'all 0.3s ease';
              setTimeout(() => window.location.reload(), 300);
            }
          } else {
            const error = await response.json();
            alert('Error al eliminar: ' + error.error);
          }
        } catch (error) {
          alert('Error al eliminar el campo');
        }
      });
    });

    document.getElementById('addFieldBtn')?.addEventListener('click', async () => {
      modal?.classList.remove('hidden');
      
      try {
        const response = await fetch('/api/categories');
        const categories = await response.json();
        
        const select = document.getElementById('relationCategory') as HTMLSelectElement;
        if (select) {
          select.innerHTML = '<option value="">Selecciona una categoría...</option>';
          
          categories.forEach((cat: any) => {
            // Permitir todas las categorías, incluida la actual
            const option = document.createElement('option');
            option.value = cat.id;
            option.textContent = cat.name;
            
            // Marcar si es la categoría actual (opcional, para dar contexto)
            if (cat.id === categoryId) {
              option.textContent = `${cat.name} (esta categoría)`;
            }
            
            select.appendChild(option);
          });
        }
      } catch (error) {
        console.error('Error loading categories:', error);
      }
    });

// Mostrar/ocultar configuración de relación según el tipo
document.getElementById('fieldType')?.addEventListener('change', (e) => {
  const type = (e.target as HTMLSelectElement).value;
  const relationConfig = document.getElementById('relationConfig');
  const enumConfig = document.getElementById('enumConfig'); // Si existe
  
  // Ocultar todas las configs
  relationConfig?.classList.add('hidden');
  enumConfig?.classList.add('hidden');
  
  // Mostrar la config apropiada
  if (type === 'relation') {
    relationConfig?.classList.remove('hidden');
  } else if (type === 'enum') {
    enumConfig?.classList.remove('hidden');
  }
});

// Al enviar el formulario
document.getElementById('fieldForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const type = (document.getElementById('fieldType') as HTMLSelectElement).value;
  const labelValue = (document.getElementById('fieldLabel') as HTMLInputElement).value;
  let nameValue = (document.getElementById('fieldName') as HTMLInputElement).value;
  
  // Auto-generar nombre si está vacío
  if (!nameValue && labelValue) {
    nameValue = labelValue.toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '');
  }
  
  let config: any = {};
  
  // Configuración específica para relaciones
  if (type === 'relation') {
    const relatedCategoryId = (document.getElementById('relationCategory') as HTMLSelectElement).value;
    const allowMultiple = (document.getElementById('relationMultiple') as HTMLInputElement).checked;
    
    if (!relatedCategoryId) {
      alert('Debes seleccionar una categoría relacionada');
      return; // Detener aquí, no hacer la petición
    }
    
    config = {
      related_category_id: relatedCategoryId,
      allow_multiple: allowMultiple
    };
  }
  // Configuración para enums
  else if (type === 'enum') {
    const optionsInput = document.getElementById('enumOptions') as HTMLInputElement;
    const options = optionsInput?.value.split(',').map(s => s.trim()).filter(Boolean) || [];
    
    if (options.length === 0) {
      alert('Debes añadir al menos una opción para un campo enum');
      return;
    }
    
    config = { options };
  }
  
  const data = {
    category_id: categoryId,
    name: nameValue,
    label: labelValue,
    type: type,
    help_text: (document.getElementById('fieldHelp') as HTMLInputElement).value,
    required: (document.getElementById('fieldRequired') as HTMLInputElement).checked,
    unique_value: (document.getElementById('fieldUnique') as HTMLInputElement).checked,
    config: config,
    field_order: 999
  };
  
  // Validación final antes de enviar
  console.log('Enviando campo:', data);
  
  try {
    const response = await fetch('/api/fields', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    const result = await response.json();
    
    if (response.ok) {
      console.log('✅ Campo creado exitosamente');
      window.location.reload();
    } else {
      console.error('❌ Error del servidor:', result);
      alert('Error al crear el campo: ' + result.error);
    }
  } catch (error) {
    console.error('❌ Error de red:', error);
    alert('Error al crear el campo. Verifica la consola.');
  }
});

    function generateSlug(text: string): string {
      return text.toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '_')
        .replace(/^_+|_+$/g, '');
    }

    // Delete category
    document.getElementById('deleteBtn')?.addEventListener('click', async () => {
      if (!confirm('¿Estás seguro? Se eliminarán todas las entradas y campos.')) return;
      
      try {
        const response = await fetch('/api/categories', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: categoryId })
        });
        
        if (response.ok) {
          window.location.href = '/categories';
        }
      } catch (error) {
        alert('Error al eliminar la categoría');
      }
    });
  </script>
</body>
</html>