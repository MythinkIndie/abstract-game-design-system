---
// src/pages/categories/create.astro
const colors = [
  '#ef4444', '#f97316', '#f59e0b', '#eab308', '#84cc16',
  '#22c55e', '#10b981', '#14b8a6', '#06b6d4', '#0ea5e9',
  '#3b82f6', '#6366f1', '#8b5cf6', '#a855f7', '#d946ef',
  '#ec4899', '#f43f5e', '#6b7280'
];

const icons = [
  'box', 'user', 'shield', 'sword', 'star', 'heart', 'zap',
  'target', 'award', 'bookmark', 'book', 'briefcase', 'camera',
  'compass', 'crown', 'diamond', 'flag', 'gift', 'map', 'package'
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear Categoría - Sistema de Diseño</title>
</head>
<body class="bg-gray-50 min-h-screen">
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <a href="/categories" class="text-sm text-gray-500 hover:text-gray-700">← Volver a categorías</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1">Crear Nueva Categoría</h1>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white rounded-lg shadow border border-gray-200 p-8">
      <form id="categoryForm" class="space-y-6">
        <!-- Nombre -->
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
            Nombre de la Categoría *
          </label>
          <input 
            type="text" 
            id="name" 
            name="name"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            placeholder="Ej: Character, Ability, Item, Quest"
          />
          <p class="text-xs text-gray-500 mt-1">Este será el nombre visible en el sistema</p>
        </div>

        <!-- Slug (auto-generado) -->
        <div>
          <label for="slug" class="block text-sm font-medium text-gray-700 mb-2">
            Slug (URL amigable) *
          </label>
          <input 
            type="text" 
            id="slug" 
            name="slug"
            required
            readonly
            class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50"
            placeholder="se-genera-automaticamente"
          />
          <p class="text-xs text-gray-500 mt-1">Se genera automáticamente del nombre</p>
        </div>

        <!-- Descripción -->
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
            Descripción
          </label>
          <textarea 
            id="description" 
            name="description"
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            placeholder="¿Qué tipo de contenido contendrá esta categoría?"
          ></textarea>
        </div>

        <!-- Color -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Color de Identificación
          </label>
          <div class="grid grid-cols-9 gap-2">
            {colors.map((color, index) => (
              <button
                type="button"
                class="color-btn w-10 h-10 rounded-lg border-2 border-transparent hover:border-gray-400 transition"
                style={`background-color: ${color}`}
                data-color={color}
                data-selected={index === 5 ? 'true' : 'false'}
              ></button>
            ))}
          </div>
          <input type="hidden" id="color" name="color" value={colors[5]} />
        </div>

        <!-- Icon (simplificado) -->
        <input type="hidden" id="icon" name="icon" value="box" />

        <!-- Info Box -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <div class="flex gap-3">
            <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="text-sm text-blue-900">
              <p class="font-medium mb-1">Herencia automática</p>
              <p>Esta categoría heredará automáticamente los campos base de <strong>Entity</strong>: título, descripción, estado y etiquetas.</p>
            </div>
          </div>
        </div>

        <!-- Botones -->
        <div class="flex gap-3 pt-4">
          <button 
            type="submit"
            class="flex-1 px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-medium"
          >
            Crear Categoría
          </button>
          <a 
            href="/categories"
            class="px-6 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition font-medium"
          >
            Cancelar
          </a>
        </div>
      </form>
    </div>

    <!-- Preview Card -->
    <div class="mt-8 bg-white rounded-lg shadow border border-gray-200 p-6">
      <h3 class="text-sm font-medium text-gray-700 mb-4">Vista Previa</h3>
      <div id="preview" class="flex items-start gap-4">
        <div id="previewColor" class="w-12 h-12 rounded-lg flex items-center justify-center text-white font-bold text-lg" style="background-color: #22c55e">
          
        </div>
        <div class="flex-1">
          <h4 id="previewName" class="text-lg font-semibold text-gray-900">Nombre de Categoría</h4>
          <p id="previewDesc" class="text-sm text-gray-500 mt-1">Descripción de la categoría...</p>
          <p id="previewSlug" class="text-xs text-gray-400 mt-2">/slug-de-la-categoria</p>
        </div>
      </div>
    </div>
  </main>

  <script>
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    const descInput = document.getElementById('description') as HTMLTextAreaElement;
    const colorInput = document.getElementById('color') as HTMLInputElement;
    const form = document.getElementById('categoryForm') as HTMLFormElement;

    const previewName = document.getElementById('previewName')!;
    const previewDesc = document.getElementById('previewDesc')!;
    const previewSlug = document.getElementById('previewSlug')!;
    const previewColor = document.getElementById('previewColor')!;

    // Auto-generar slug
    function generateSlug(text: string): string {
      return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    nameInput.addEventListener('input', () => {

      const slug = generateSlug(nameInput.value);
      slugInput.value = slug;
      
      // Update preview
      previewName.textContent = nameInput.value || 'Nombre de Categoría';
      previewSlug.textContent = `/${slug || 'slug-de-la-categoria'}`;
      previewColor.textContent = (nameInput.value || '').substring(0, 2).toUpperCase();
    });

    descInput.addEventListener('input', () => {
      previewDesc.textContent = descInput.value || 'Descripción de la categoría...';
    });

    // Color selection
    document.querySelectorAll('.color-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.color-btn').forEach(b => {
          b.setAttribute('data-selected', 'false');
          b.classList.remove('ring-2', 'ring-offset-2', 'ring-gray-400');
        });
        
        btn.setAttribute('data-selected', 'true');
        btn.classList.add('ring-2', 'ring-offset-2', 'ring-gray-400');
        
        const color = (btn as HTMLElement).dataset.color!;
        colorInput.value = color;
        previewColor.style.backgroundColor = color;
      });
    });

    // Seleccionar color inicial
    document.querySelector('[data-selected="true"]')?.classList.add('ring-2', 'ring-offset-2', 'ring-gray-400');

    // Submit form
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = {
        name: nameInput.value,
        slug: slugInput.value,
        description: descInput.value,
        color: colorInput.value,
        icon: 'box'
      };
      
      try {
        const response = await fetch('/api/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });
        
        if (response.ok) {
          const data = await response.json();
          window.location.href = `/categories/${data.slug}`;
        } else {
          const error = await response.json();
          alert(`Error: ${error.error}`);
        }
      } catch (error) {
        alert('Error al crear la categoría');
        console.error(error);
      }
    });
  </script>
</body>
</html>