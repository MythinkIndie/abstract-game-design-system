---
import { getSupabaseClient } from "@/lib/supabaseClient";
const context = Astro.request;
const cookies = context.headers.get('cookie') || '';
const actualUser = cookies.match(/username=([^;]+)/)?.[1] || '';

const supabase = getSupabaseClient();
const usersResponse = await supabase.from('users').select('*');
const rolesResponse = await supabase.from('roles').select('*');
const userRolesResponse = await supabase.from('user_roles').select('*');
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Administrador - Gestión de usuarios</title>
</head>

<body class="bg-gradient-to-br from-indigo-500 to-purple-600 min-h-screen p-6">
  <div class="max-w-5xl mx-auto bg-white rounded-xl shadow-xl p-6">

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-800">
        👤 Gestión de usuarios
      </h1>

      <button
        id="newUser"
        class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition"
      >
        <a href="/admin/createUser">
          ➕ Nuevo usuario
        </a>
      </button>
    </div>

    <!-- Tabla -->
    <div class="overflow-x-auto">
      <table class="min-w-full border border-gray-200 rounded-lg overflow-hidden">
        <thead class="bg-gray-100">
          <tr class="text-left text-sm text-gray-600">
            <th class="px-4 py-3">Usuario</th>
            <th class="px-4 py-3">Estado</th>
            <th class="px-4 py-3">Rol</th>
            <th class="px-4 py-3 text-right">Acciones</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-gray-200 text-sm">
          {usersResponse.data && usersResponse.data.map((user: any) => (
            <tr class="hover:bg-gray-50 transition">
              <td class="px-4 py-3 font-medium text-gray-800">
                {user.username} {user.username == actualUser && (<span class="text-indigo-600 font-bold">(Tú)</span>)}
              </td>

              <td class="px-4 py-3">
                {user.is_active == 1 ? (
                  <span class="inline-flex items-center px-2 py-1 text-xs font-semibold text-green-700 bg-green-100 rounded-full">
                    ✔ Activo
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2 py-1 text-xs font-semibold text-red-700 bg-red-100 rounded-full">
                    ✖ Inactivo
                  </span>
                )}
              </td>

              <td class="px-4 py-3">
                <span class="inline-flex items-center px-2 py-1 text-xs font-semibold text-indigo-700 bg-indigo-100 rounded-full">
                  {
                    rolesResponse.data && userRolesResponse.data && rolesResponse.data.find(
                      (role: any) =>
                        role.id ==
                        userRolesResponse.data.find(
                          (userRole: any) => userRole.user_id == user.id
                        )?.role_id
                    )?.name
                  }
                </span>
              </td>

              <td class="px-4 py-3 text-right space-x-2">
                <button
                  data-id={user.id}
                  class="edit px-3 py-1 text-xs font-semibold text-blue-600 bg-blue-100 rounded hover:bg-blue-200 transition"
                >
                  Editar
                </button>

                <button
                  data-id={user.id}
                  data-username={user.username}
                  class="delete px-3 py-1 text-xs font-semibold text-red-600 bg-red-100 rounded hover:bg-red-200 transition"
                >
                  Eliminar
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

  </div>
  <script>
    document.querySelectorAll('.edit').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        window.location.href = `/admin/editUser/${id}`;
      });
    });
    document.querySelectorAll('.delete').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const username = target.dataset.username;
        
        if (!confirm(`¿Eliminar el usuario "${username}"?`)) return;

        try {
          const response = await fetch('/api/users', {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ id, username }),
          });

          if (response.ok) {
            alert(`Usuario "${username}" eliminado correctamente.`);
            window.location.reload();
          } else {
            const errorData = await response.json();
            alert(`Error al eliminar el usuario: ${errorData.message}`);
          }
        } catch (error) {
          alert(`Error al eliminar el usuario: ${error}`);
        }
      });
    });
  </script>
</body>
</html>