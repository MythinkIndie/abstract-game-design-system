---
import { getSupabaseClient } from "@/lib/supabaseClient";

const supabase = getSupabaseClient();
const rolesResponse = await supabase.from('roles').select('*');
---


<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Administrador - Crear usuario</title>
</head>

<body class="bg-gradient-to-br from-indigo-500 to-purple-600 min-h-screen flex items-center justify-center p-6">

  <div class="w-full max-w-md bg-white rounded-xl shadow-xl p-6">
    
    <!-- Header -->
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">
        ➕ Crear nuevo usuario
      </h1>
      <p class="text-sm text-gray-500">
        Completa los datos para dar de alta un usuario
      </p>
    </div>

    <!-- Formulario -->
    <form id="createUserForm" class="space-y-4">

      <!-- Usuario -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Usuario
        </label>
        <input
          type="text"
          id="username"
          name="username"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          placeholder="nombre_de_usuario"
        />
      </div>

      <!-- Contraseña -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Contraseña
        </label>
        <input
          type="password"
          id="password"
          name="password"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          placeholder="••••••••"
        />
      </div>

      <!-- Confirmar contraseña -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Confirmar contraseña
        </label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          placeholder="••••••••"
        />
      </div>

      <!-- Rol -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Rol
        </label>
        <select
          name="role"
          id="role"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
        >
          {rolesResponse.data && rolesResponse.data.map((role: any) => (
            <option value={role.id}>
              {role.name}
            </option>
          ))}
        </select>
      </div>

      <div id="errorMessage" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-600 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="errorText"></span>
        </p>
      </div>

      <!-- Acciones -->
      <div class="flex items-center justify-between pt-4">
        <a
          href="/admin/users"
          class="text-sm text-gray-500 hover:text-gray-700"
        >
          ← Volver
        </a>

        <button
          type="submit"
          id="createUserBtn"
          class="px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition"
        >
          Crear usuario
        </button>
      </div>

    </form>
  </div>
  <script>
    const form = document.getElementById('createUserForm') as HTMLFormElement;
    const errorMessage = document.getElementById('errorMessage')!;
    const errorText = document.getElementById('errorText')!;
    const createUserBtn = document.getElementById('createUserBtn')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const username = (document.getElementById('username') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const role = (document.getElementById('role') as HTMLSelectElement).value;
      const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;
      
      if (password !== confirmPassword) {
        showError('Las contraseñas no coinciden');
        return;
      }

      // Ocultar error anterior
      errorMessage.classList.add('hidden');
      
      // Deshabilitar botón
      createUserBtn.textContent = 'Verificando...';
      createUserBtn.setAttribute('disabled', 'true');
      
      try {
        const response = await fetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password, role })
        });
        
        const data = await response.json();
        
        if (response.ok) {
          createUserBtn.textContent = '✓ Acceso concedido';
          createUserBtn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
          createUserBtn.classList.add('bg-green-600');
          
          // Redirigir después de un momento
          setTimeout(() => {
            window.location.href = '/';
          }, 500);
        } else {
          showError(data.error || 'Error al iniciar sesión');
          createUserBtn.textContent = 'Iniciar Sesión';
          createUserBtn.removeAttribute('disabled');
        }
      } catch (error) {
        showError('Error de conexión. Intenta nuevamente.');
        createUserBtn.textContent = 'Iniciar Sesión';
        createUserBtn.removeAttribute('disabled');
      }
    });
    
    function showError(message: string) {
      errorText.textContent = message;
      errorMessage.classList.remove('hidden');
    }
  </script>
</body>
</html>
