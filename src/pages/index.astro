---
// src/pages/index.astro (ACTUALIZADO)
import GlobalSearch from '@/components/GlobalSearch.astro';
import { getServiceClient } from '@/lib/supabaseClient';

const supabase = getServiceClient();

// Obtener estadísticas
const categories = await supabase.from('categories').select('id', { count: 'exact', head: true }).eq('is_system', false).single();;
const entries = await supabase.from('entries').select('id', { count: 'exact', head: true }).single();

// Verificar si existe sistema de tareas
const taskCategory = await supabase.from('categories').select('id').eq('slug', 'task').single();
let taskStats = { total: 0, todo: 0, in_progress: 0, done: 0 };

if (taskCategory.data) {
  const allTasks = await supabase.from('entries').select('*').eq('category_id', taskCategory.data.id);
  taskStats.total = allTasks.data?.length || 0;
  
  allTasks.data?.forEach(task => {
    try {
      const data = JSON.parse(task.data);
      if (data.status === 'todo') taskStats.todo++;
      else if (data.status === 'in_progress') taskStats.in_progress++;
      else if (data.status === 'done') taskStats.done++;
    } catch {}
  });
}

// Obtener meta info
const metaCategory = await supabase.from('categories').select('id').eq('slug', 'meta').single()
const metaEntry = await supabase.from('entries').select('*').eq('category_id', metaCategory.data!.id).single();

let projectName = 'Nuevo Proyecto';
if (metaEntry) {
  try {
    const data = JSON.parse(metaEntry.data);
    projectName = data.project_name || projectName;
  } catch {

  }
}

// Obtener categorías recientes
const recentCategories = await supabase.from('categories')
  .select('*')
  .eq('is_system', false)
  .order('created_at', { ascending: false })
  .limit(5);

// Obtener entradas recientes
const recentEntries = await supabase.from('entries').select(`
  *,
  category:categories ( name, slug, color )
`)
  .neq('category.slug', 'task')
  .order('updated_at', { ascending: false })
  .limit(8);

// Calcular progreso general del proyecto
const allEntries = await supabase.from('entries').select('id, category_id');
let totalProgress = 0;
let entriesWithProgress = 0;

for (const entry of allEntries.data!) {

  const fields = await supabase.from('fields').select('id').eq('category_id', entry.category_id);
  if (fields.data?.length === 0) continue;
  
  const completionStates = await supabase.from('field_completion').select('COUNT(*) as count', { count: 'exact', head: true }).eq('entry_id', entry.id).eq('is_complete', 1);
  if (!completionStates.data || completionStates.data.length === 0) {
    continue;
  }
  const progress = (completionStates.data[0].count / fields.data!.length) * 100;
  totalProgress += progress;
  entriesWithProgress++;
}

const context = Astro.request;
const cookies = context.headers.get('cookie') || '';
const actualUser = cookies.match(/username=([^;]+)/)?.[1] || '';

const actualUserEntry = await supabase.from('users').select('*').eq('username', actualUser).single();
const actualUserRole = await supabase.from('roles').select('name').eq('id', actualUserEntry.data.role_id).single();

const overallProgress = entriesWithProgress > 0 ? Math.round(totalProgress / entriesWithProgress) : 0;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{projectName} - Sistema de Diseño de Videojuegos</title>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Header -->
  <header class="bg-white shadow-sm border-b border-gray-200">
  <div class="w-full px-4 sm:px-6 lg:px-12 py-4">

    <div class="flex items-center justify-between gap-4">
      
      <!-- IZQUIERDA -->
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-gray-900">
          {projectName}
        </h1>
        <p class="hidden sm:block text-sm text-gray-500">
          Sistema de Diseño de Videojuegos
        </p>
      </div>

      <!-- SEARCH (solo desktop) -->
      <div class="hidden lg:block">
        <GlobalSearch />
      </div>

      <!-- BOTÓN MENÚ MÓVIL -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded-lg hover:bg-gray-100"
        aria-label="Abrir menú"
      >
        ☰
      </button>

      <!-- NAV DESKTOP -->
      <nav class="hidden lg:flex gap-4">
        {taskCategory && (
          <a href="/tasks" class="px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition">
            📋 Tareas
          </a>
        )}
        <a href="/categories" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
          Ver Categorías
        </a>
        {actualUserRole.data && (actualUserRole.data.name === 'admin' || actualUserRole.data.name === 'moderator') && (
          <a href="/categories/create" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition">
          Nueva Categoría
        </a>
        )}
      </nav>
    </div>

    <!-- MENÚ MÓVIL -->
    <div id="mobile-menu" class="hidden lg:hidden mt-4 space-y-3">

      <GlobalSearch />

      {taskCategory && (
        <a
          href="/tasks"
          class="block w-full text-center px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition"
        >
          📋 Tareas
        </a>
      )}

      <a
        href="/categories"
        class="block w-full text-center px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition"
      >
        Ver Categorías
      </a>

      {actualUserRole.data && (actualUserRole.data.name === 'admin' || actualUserRole.data.name === 'moderator') && (
      <a
        href="/categories/create"
        class="block w-full text-center px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition"
      >
        Nueva Categoría
      </a>
      )}
    </div>
  </div>
</header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Categorías Custom</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">{categories.count}</p>
          </div>
          <div class="p-3 bg-indigo-100 rounded-lg">
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Entradas Totales</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">{entries.count}</p>
          </div>
          <div class="p-3 bg-green-100 rounded-lg">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
        </div>
      </div>

      {taskCategory && (
        <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600">Tareas Activas</p>
              <p class="text-3xl font-bold text-gray-900 mt-2">{taskStats.todo + taskStats.in_progress}</p>
              <p class="text-xs text-gray-500 mt-1">{taskStats.done} completadas</p>
            </div>
            <div class="p-3 bg-yellow-100 rounded-lg">
              <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
          </div>
        </div>
      )}

      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Progreso General</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">{overallProgress}%</p>
          </div>
          <div class="p-3 bg-purple-100 rounded-lg">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    {!taskCategory && (
      <div class="mb-8 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-lg shadow-lg p-6 text-white">
        <div class="flex items-start gap-4">
          <svg class="w-8 h-8 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="flex-1">
            <h3 class="text-lg font-semibold mb-2">🎯 Activa el Sistema de Tareas</h3>
            <p class="text-sm text-white/90 mb-4">
              Gestiona qué contenido falta por añadir, marca campos como completos y organiza tu trabajo con un tablero Kanban.
            </p>
            <a href="/api/tasks/migrate" class="inline-block px-6 py-2 bg-white text-orange-600 rounded-lg hover:bg-gray-100 transition font-medium">
              Activar Ahora
            </a>
          </div>
        </div>
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Categorías Recientes -->
      <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Categorías Recientes</h2>
        </div>
        <div class="p-6">
          {recentCategories.data && recentCategories.data.length === 0 ? (
            <div class="text-center py-8">
              <p class="text-gray-500 mb-4">No hay categorías aún</p>
              {actualUserRole.data && (actualUserRole.data.name === 'admin' || actualUserRole.data.name === 'moderator') && (
              <a href="/categories/create" class="inline-block px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
                Crear Primera Categoría
              </a>
              )}
            </div>
          ) : (
            <div class="space-y-3">
              {recentCategories.data &&recentCategories.data.map((cat: any) => (
                <a 
                  href={`/categories/${cat.slug}`}
                  class="block p-4 rounded-lg border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50 transition"
                >
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white font-semibold" style={`background-color: ${cat.color}`}>
                      {cat.name.substring(0, 2).toUpperCase()}
                    </div>
                    <div>
                      <h3 class="font-semibold text-gray-900">{cat.name}</h3>
                      <p class="text-sm text-gray-500">{cat.description || 'Sin descripción'}</p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Entradas Recientes -->
      <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Actividad Reciente</h2>
        </div>
        <div class="p-6">
          {recentEntries.data && recentEntries.data.length <= 2 ? (
            <div class="text-center flex items-center justify-center py-12">
              <p class="text-gray-500">No hay entradas todavía</p>
            </div>
          ) : (
            <div class="space-y-3">
              {recentEntries.data && recentEntries.data.slice(2, recentEntries.data.length-2).map((entry: any) => (
                <a 
                  href={`/entries/${entry.category_slug}/${entry.id}`}
                  class="block p-3 rounded-lg border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition"
                >
                  <div class="flex items-start gap-3">
                    <div class="w-2 h-2 rounded-full mt-2" style={`background-color: ${entry.category_color}`}></div>
                    <div class="flex-1 min-w-0">
                      <h3 class="font-medium text-gray-900 truncate">{entry.title}</h3>
                      <p class="text-xs text-gray-500 mt-1">
                        {entry.category_name} • {new Date(entry.updated_at).toLocaleDateString('es-ES')}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </main>

  <footer class="bg-white border-t border-gray-200 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <p class="text-center text-sm text-gray-500">
        Sistema de Diseño de Videojuegos • Basado en Entidades • SQLite Local
      </p>
    </div>
  </footer>

  <script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

    toggle?.addEventListener('click', () => {
      menu!.classList.toggle('hidden');
    });
</script>
</body>
</html>