<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configuración Inicial - Sistema de Diseño</title>
</head>
<body class="bg-gradient-to-br from-purple-500 to-pink-600 min-h-screen flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl p-8">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-purple-100 rounded-full mb-4">
        <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Configuración del Sistema</h1>
      <p class="text-gray-600 text-sm">Configura la seguridad de tu aplicación</p>
    </div>

    <form id="setupForm" class="space-y-6">
      <div>
        <label for="adminName" class="block text-sm font-medium text-gray-700 mb-2">
          Nombre del administrador *
        </label>
        <input 
          type="text" 
          id="adminName" 
          name="adminName"
          required
          minlength="8"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
          placeholder="Por favor, no pongas 'admin'"
        />
        <p class="text-xs text-gray-500 mt-1">
          Esta sera la cuenta del admin para poder gestionar la aplicación
        </p>
      </div>
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
          Contraseña de Acceso *
        </label>
        <input 
          type="password" 
          id="password" 
          name="password"
          required
          minlength="8"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
          placeholder="Mínimo 8 caracteres"
        />
        <p class="text-xs text-gray-500 mt-1">
          Esta será la contraseña de esta cuenta de administrador
        </p>
      </div>

      <div>
        <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
          Confirmar Contraseña *
        </label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword"
          required
          minlength="8"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
          placeholder="Repite la contraseña"
        />
      </div>

      <div class="flex items-start gap-3 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
        <input 
          type="checkbox" 
          id="enablePrivateMode"
          class="mt-1 rounded"
        />
        <div class="flex-1">
          <label for="enablePrivateMode" class="block text-sm font-medium text-gray-900 cursor-pointer">
            🔒 Activar Modo Privado
          </label>
          <p class="text-xs text-gray-600 mt-1">
            Requerirá autenticación para acceder a la aplicación. Si no se activa, cualquier persona puede ver el proyecto pero no editarlo sin un usuario.
          </p>
        </div>
      </div>

      <div id="errorMessage" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-600 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="errorText"></span>
        </p>
      </div>

      <div class="flex gap-3">
        <button 
          type="submit"
          id="setupBtn"
          class="flex-1 px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition font-medium shadow-lg hover:shadow-xl"
        >
          Guardar Configuración
        </button>
      </div>
    </form>

    <div class="mt-6 p-4 bg-gray-50 rounded-lg">
      <p class="text-xs text-gray-600">
        <strong>Nota:</strong> Guarda esta contraseña en un lugar seguro. Si la olvidas, necesitarás acceso directo a la base de datos para resetearla.
      </p>
    </div>
  </div>

  <script>
    const form = document.getElementById('setupForm') as HTMLFormElement;
    const errorMessage = document.getElementById('errorMessage')!;
    const errorText = document.getElementById('errorText')!;
    const setupBtn = document.getElementById('setupBtn')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const adminuser = (document.getElementById('adminName') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;
      const enablePrivateMode = (document.getElementById('enablePrivateMode') as HTMLInputElement).checked;
      
      // Validar que las contraseñas coincidan
      if (password !== confirmPassword) {
        showError('Las contraseñas no coinciden');
        return;
      }
      
      // Ocultar error anterior
      errorMessage.classList.add('hidden');
      
      // Deshabilitar botón
      setupBtn.textContent = 'Guardando...';
      setupBtn.setAttribute('disabled', 'true');
      
      try {
        const response = await fetch('/api/auth/setup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            adminuser,
            password, 
            enable_private_mode: enablePrivateMode 
          })
        });

        const data = await response.json();
        
        if (response.ok) {
          setupBtn.textContent = '✓ Configuración guardada';
          setupBtn.classList.remove('bg-purple-600', 'hover:bg-purple-700');
          setupBtn.classList.add('bg-green-600');
          
          // Redirigir después de un momento
          setTimeout(() => {
            if (enablePrivateMode) {
              window.location.href = '/login';
            } else {
              window.location.href = '/';
            }
          }, 1500);
        } else {
          showError(data.error || 'Error al guardar la configuración');
          setupBtn.textContent = 'Guardar Configuración';
          setupBtn.removeAttribute('disabled');
        }
      } catch (error) {
        showError('Error de conexión. Intenta nuevamente.');
        setupBtn.textContent = 'Guardar Configuración';
        setupBtn.removeAttribute('disabled');
      }
    });
    
    function showError(message: string) {
      errorText.textContent = message;
      errorMessage.classList.remove('hidden');
    }
  </script>
</body>
</html>