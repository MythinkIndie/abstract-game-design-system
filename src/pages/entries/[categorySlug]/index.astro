---
// src/pages/entries/[categorySlug]/index.astro
import { db } from '@/lib/db';

const { categorySlug } = Astro.params;

const category = db!.prepare('SELECT * FROM categories WHERE slug = ?').get(categorySlug);

if (!category) {
  return Astro.redirect('/categories');
}

const entries = db!.prepare(`
  SELECT * FROM entries 
  WHERE category_id = ? 
  ORDER BY updated_at DESC
`).all((category as any).id);

const fields = db!.prepare('SELECT * FROM fields WHERE category_id = ? ORDER BY field_order').all((category as any).id);

// Obtener estado de tareas para cada entrada
const taskCategory = db!.prepare('SELECT id FROM categories WHERE slug = ?').get('task') as any;
const entriesWithTaskStatus = (entries as any[]).map(entry => {
  let hasPendingTasks = false;
  let totalTasks = 0;
  let completedTasks = 0;
  
  if (taskCategory) {
    // Buscar tareas que apliquen a esta entrada
    const allTasks = db!.prepare(`
      SELECT id, data FROM entries 
      WHERE category_id = ? 
        AND json_extract(data, '$.related_category_id') = ?
    `).all(taskCategory.id, (category as any).id) as any[];
    
    const applicableTasks = allTasks.filter((task: any) => {
      const data = JSON.parse(task.data);
      return data.applies_to_all || (data.specific_entry_ids && data.specific_entry_ids.includes(entry.id));
    });
    
    totalTasks = applicableTasks.length;
    
    // Contar completadas
    const completed = db!.prepare(`
      SELECT COUNT(*) as count FROM task_completion
      WHERE entry_id = ? AND is_completed = 1
    `).get(entry.id) as any;
    
    completedTasks = completed?.count || 0;
    hasPendingTasks = totalTasks > completedTasks;
  }
  
  return {
    ...entry,
    hasPendingTasks,
    totalTasks,
    completedTasks
  };
});
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Entradas de {(category as any).name}</title>
</head>
<body class="bg-gray-50 min-h-screen">
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <a href="/categories" class="text-sm text-gray-500 hover:text-gray-700">← Volver a categorías</a>
      <div class="flex items-center justify-between mt-2">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center text-white font-bold text-lg" style={`background-color: ${(category as any).color}`}>
            {(category as any).name.substring(0, 2).toUpperCase()}
          </div>
          <div>
            <h1 class="text-2xl font-bold text-gray-900">Entradas de {(category as any).name}</h1>
            <p class="text-sm text-gray-500">{entries.length} {entries.length === 1 ? 'entrada' : 'entradas'}</p>
          </div>
        </div>
        <div class="flex gap-3">
          <a href={`/categories/${categorySlug}`} class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition">
            Configurar Categoría
          </a>
          <a href={`/entries/${categorySlug}/create`} class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
            + Nueva Entrada
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {entries.length === 0 ? (
      <div class="bg-white rounded-lg shadow border border-gray-200 p-12 text-center">
        <div class="max-w-md mx-auto">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">No hay entradas todavía</h3>
          <p class="text-gray-500 mb-6">Crea tu primera entrada de tipo {(category as any).name}</p>
          <a href={`/entries/${categorySlug}/create`} class="inline-block px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-medium">
            Crear Primera Entrada
          </a>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {entries.map((entry: any) => {
          let data = {};
          try {
            data = JSON.parse(entry.data);
          } catch {}
          
          return (
            <a 
              href={`/entries/${categorySlug}/${entry.id}`}
              class={`block bg-white rounded-lg shadow border-2 hover:shadow-lg transition ${
                entry.hasPendingTasks ? 'border-red-300' : 'border-gray-200 hover:border-indigo-300'
              }`}
            >
              <div class="p-6">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-lg font-semibold text-gray-900 flex-1 line-clamp-2">{entry.title}</h3>
                  <div class="flex flex-col items-end gap-1 ml-3">
                    <div class="w-2 h-2 rounded-full" style={`background-color: ${(category as any).color}`}></div>
                    {entry.hasPendingTasks && (
                      <span class="px-2 py-0.5 bg-red-100 text-red-700 text-xs font-medium rounded">
                        ⚠️ Tareas
                      </span>
                    )}
                  </div>
                </div>
                
                {(data as any).description && (
                  <p class="text-sm text-gray-600 line-clamp-3 mb-4">
                    {(data as any).description.replace(/#/g, '').substring(0, 150)}...
                  </p>
                )}
                
                <div class="space-y-2">
                  {(data as any).status && (
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-medium text-gray-500">Estado:</span>
                      <span class={`px-2 py-0.5 text-xs font-medium rounded ${
                        (data as any).status === 'approved' ? 'bg-green-100 text-green-700' :
                        (data as any).status === 'review' ? 'bg-yellow-100 text-yellow-700' :
                        (data as any).status === 'deprecated' ? 'bg-red-100 text-red-700' :
                        'bg-gray-100 text-gray-600'
                      }`}>
                        {(data as any).status}
                      </span>
                    </div>
                  )}
                  
                  {(data as any).tags && (data as any).tags.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-2">
                      {(data as any).tags.slice(0, 3).map((tag: string) => (
                        <span class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
              
              <div class="border-t border-gray-200 px-6 py-3 bg-gray-50 flex items-center justify-between">
                <span class="text-xs text-gray-500">
                  {new Date(entry.updated_at).toLocaleDateString('es-ES')}
                </span>
                <button 
                  class="delete-entry text-gray-400 hover:text-red-600 transition"
                  data-id={entry.id}
                  data-title={entry.title}
                  onclick="event.preventDefault(); event.stopPropagation();"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </main>

  <script>
    document.querySelectorAll('.delete-entry').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const title = target.dataset.title;
        
        if (!confirm(`¿Eliminar "${title}"?`)) return;
        
        try {
          const response = await fetch('/api/entries', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });
          
          if (response.ok) {
            window.location.reload();
          }
        } catch (error) {
          alert('Error al eliminar la entrada');
        }
      });
    });
  </script>
</body>
</html>