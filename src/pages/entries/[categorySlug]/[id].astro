---
import { getSupabaseClient } from '@/lib/supabaseClient';
import EntryTasksWidget from '@/components/EntryTasksWidget.astro';
import FieldRenderer from '@/components/FieldRenderer.astro';
import EntryHeader from './components/EntryHeader.astro';
import EntryProgress from './components/EntryProgress.astro';
import EntryComments from './components/EntryComments.astro';
import EntryAssignment from './components/EntryAssignment.astro';

const { categorySlug, id } = Astro.params;

const supabase = getSupabaseClient();
const category = await supabase.from('categories').select('*').eq('slug', categorySlug).single();
if (!category || !category.data) return Astro.redirect('/categories');

const entry = await supabase.from('entries').select('*').eq('id', id).single();
if (!entry || !entry.data) return Astro.redirect(`/entries/${categorySlug}`);

const fields = await supabase.from('fields').select('*').eq('category_id', (category.data as any).id).order('field_order', { ascending: true });

let entryData: any = {};
try {
  entryData = JSON.parse((entry.data as any).data);
} catch (e) {
  console.error('Error parsing entry data:', e);
}

console.log('Entry Data:', fields.data);
// Calcular progreso
const completionStates = await supabase.from('field_completion').select('field_id, is_complete, completion_notes').eq('entry_id', id);

const completionMap = new Map((completionStates.data as any[]).map(c => [c.field_id, {is_complete: c.is_complete === 1, completion_notes: c.completion_notes}]));

const fieldsWithCompletion = (fields.data as any[]).map(field => {
  const hasValue = entryData[field.name] !== undefined && entryData[field.name] !== null && entryData[field.name] !== '';
  const manualCompletion = completionMap.get(field.id);
  
  return {
    ...field,
    has_value: hasValue,
    is_complete: manualCompletion?.is_complete ?? hasValue,
    completion_notes: manualCompletion?.completion_notes
  };
});

const totalFields = fieldsWithCompletion.length;
console.log('Fields with Completion:', fieldsWithCompletion);
const completedFields = fieldsWithCompletion.filter(f => f.is_complete).length;
const progress = totalFields > 0 ? Math.round((completedFields / totalFields) * 100) : 0;

// Cargar información de relaciones para mostrar títulos
const relatedEntries = new Map();
for (const field of fieldsWithCompletion) {
  if (field.type === 'relation' && entryData[field.name]) {
    const config = JSON.parse(field.config);
    const relatedIds = config.cardinality === '1:1' 
      ? [entryData[field.name]] 
      : Array.isArray(entryData[field.name]) ? entryData[field.name] : [];
    
    for (const relId of relatedIds) {
      if (relId && !relatedEntries.has(relId)) {
        const relEntry = await supabase.from('entries').select('id, title, category_id').eq('id', relId).single();
        if (relEntry.data) {
          const relCategory = await supabase.from('categories').select('slug').eq('id', relEntry.data.category_id).single();
          relatedEntries.set(relId, {
            title: relEntry.data.title,
            categorySlug: relCategory?.data?.slug
          });
        }
      }
    }
  }
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{(entry.data as any).title} - {(category.data as any).name}</title>
  <style>
    .editable-field {
      cursor: text;
      transition: all 0.2s;
      min-height: 2rem;
    }
    .editable-field:hover {
      background-color: #f9fafb;
      border-color: #d1d5db;
    }
    .editable-field:focus {
      outline: none;
      border-color: #6366f1;
      background-color: white;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen" data-entry-id={id} data-related-entries={JSON.stringify(Object.fromEntries(relatedEntries))}>
  <EntryHeader entry={entry.data} category={category.data} entryData={entryData} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Contenido Principal -->
      <div class="lg:col-span-2 space-y-6">
        <EntryProgress completedFields={completedFields} totalFields={fieldsWithCompletion.length} />

        <!-- Campos -->
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Datos</h2>
            <p class="text-xs text-gray-500 mt-1">Click en cualquier campo para editarlo directamente</p>
          </div>
          <div class="p-6 space-y-4">
            {fieldsWithCompletion && fieldsWithCompletion.map((field: any) => {
              const value = entryData[field.name];
              const isEmpty = value === undefined || value === null || value === '';
              
              // Para campos de relación, pasar info extra
              let enrichedField = field;
              if (field.type === 'relation') {
                const config = JSON.parse(field.config);
                enrichedField = {
                  ...field,
                  relatedEntries: relatedEntries
                };
              }
              
              return (
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-start justify-between mb-2">
                    <div class="flex items-center gap-2 flex-1">
                      <input 
                        type="checkbox" 
                        class="field-completion-checkbox w-5 h-5 text-indigo-600 rounded"
                        data-field-id={field.id}
                        data-entry-id={id}
                        checked={field.is_complete}
                      />
                      <div>
                        <h3 class="font-semibold text-gray-900">{field.label}</h3>
                        <p class="text-xs text-gray-500">{field.name} • {field.type}</p>
                      </div>
                    </div>
                    <span class={`px-2 py-0.5 rounded text-xs font-medium ${
                      field.is_complete ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'
                    }`}>
                      {field.is_complete ? 'Completo' : 'Pendiente'}
                    </span>
                  </div>
                  
                  {field.help_text && (
                    <p class="text-xs text-gray-500 mb-2 ml-7">{field.help_text}</p>
                  )}
                  
                  <div class="ml-7 mt-2" data-field-container={field.name}>
                    <FieldRenderer field={enrichedField} value={value} parentCategory={category.data}/>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <EntryComments comments={entryData._comments || []} />
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <EntryTasksWidget entryId={id!} categoryId={(category.data as any).id} />
        <EntryAssignment assignedTo={entryData._assigned_to} />
        
        <!-- Información -->
        <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Información</h2>
          <dl class="space-y-3">
            <div>
              <dt class="text-xs font-medium text-gray-500">ID</dt>
              <dd class="text-sm text-gray-900 font-mono">{id}</dd>
            </div>
            <div>
              <dt class="text-xs font-medium text-gray-500">Creado</dt>
              <dd class="text-sm text-gray-900">
                {new Date((entry.data as any).created_at).toLocaleDateString('es-ES')}
              </dd>
            </div>
            <div>
              <dt class="text-xs font-medium text-gray-500">Última Actualización</dt>
              <dd class="text-sm text-gray-900">
                {new Date((entry.data as any).updated_at).toLocaleDateString('es-ES')}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </main>

  <script src="../../../scripts/entryView.ts"></script>
</body>
</html>