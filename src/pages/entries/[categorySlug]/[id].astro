---
// src/pages/entries/[categorySlug]/[id].astro
import { db } from '../../../lib/db';
import EntryTasksWidget from '../../../components/EntryTasksWidget.astro';
import FieldRenderer from '../../../components/FieldRenderer.astro';

const { categorySlug, id } = Astro.params;

const category = db.prepare('SELECT * FROM categories WHERE slug = ?').get(categorySlug);
if (!category) return Astro.redirect('/categories');

const entry = db.prepare('SELECT * FROM entries WHERE id = ?').get(id);
if (!entry) return Astro.redirect(`/entries/${categorySlug}`);

const fields = db.prepare('SELECT * FROM fields WHERE category_id = ? ORDER BY field_order').all((category as any).id);

let entryData: any = {};
try {
  entryData = JSON.parse((entry as any).data);
} catch {}

// Obtener estado de completitud de campos
const completionStates = db.prepare(`
  SELECT field_id, is_complete, completion_notes 
  FROM field_completion 
  WHERE entry_id = ?
`).all(id);

const completionMap = new Map(
  (completionStates as any[]).map(c => [c.field_id, {
    is_complete: c.is_complete === 1,
    completion_notes: c.completion_notes
  }])
);

const fieldsWithCompletion = (fields as any[]).map(field => {
  const hasValue = entryData[field.name] !== undefined && entryData[field.name] !== null && entryData[field.name] !== '';
  const manualCompletion = completionMap.get(field.id);
  
  return {
    ...field,
    has_value: hasValue,
    is_complete: manualCompletion?.is_complete ?? hasValue,
    completion_notes: manualCompletion?.completion_notes
  };
});

const totalFields = fieldsWithCompletion.length;
const completedFields = fieldsWithCompletion.filter(f => f.is_complete).length;
const progress = totalFields > 0 ? Math.round((completedFields / totalFields) * 100) : 0;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{(entry as any).title} - {(category as any).name}</title>
  <style>
    .editable-field {
      cursor: text;
      transition: all 0.2s;
      min-height: 2rem;
    }
    .editable-field:hover {
      background-color: #f9fafb;
      border-color: #d1d5db;
    }
    .editable-field:focus {
      outline: none;
      border-color: #6366f1;
      background-color: white;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen" data-entry-id={id}>
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <a href={`/entries/${categorySlug}`} class="text-sm text-gray-500 hover:text-gray-700">
        ← Volver a {(category as any).name}
      </a>
      <div class="flex items-center justify-between mt-2">
        <div class="flex items-center gap-4 flex-1 min-w-0">
          <!-- Imagen de entrada -->
          <div class="relative group flex-shrink-0">
            {/* Imagen con manejo de error */}
            <img 
              id="entryImage"
              src={entryData._image || '/placeholder.svg'}
              alt={(entry as any).title}
              class="w-24 h-24 rounded-lg object-cover border-2 border-gray-200 bg-gray-100"
              onerror="this.style.display='none'; document.getElementById('imagePlaceholder').style.display='flex';"
            />
            
            {/* Placeholder SVG si no hay imagen */}
            <div 
              id="imagePlaceholder"
              class="w-24 h-24 rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 flex items-center justify-center"
              style={entryData._image ? 'display: none;' : ''}
            >
              <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            
            {/* Overlay para subir */}
            <label class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-0 group-hover:bg-opacity-60 rounded-lg cursor-pointer transition-all">
              <div class="opacity-0 group-hover:opacity-100 transition-opacity text-white text-center">
                <svg class="w-8 h-8 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <span class="text-xs font-medium">Subir imagen</span>
              </div>
              <input 
                type="file" 
                id="imageUpload"
                accept="image/jpeg,image/png,image/gif,image/webp"
                class="hidden"
              />
            </label>
            
            {/* Botón para eliminar imagen */}
            {entryData._image && (
              <button 
                id="removeImageBtn"
                class="absolute -top-2 -right-2 w-6 h-6 bg-red-600 text-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-700"
                title="Eliminar imagen"
              >
                <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            )}
          </div>
          
          <div class="flex-1 min-w-0">
            <!-- Título editable -->
            <h1 
              id="entryTitle"
              contenteditable="true"
              class="text-2xl font-bold text-gray-900 border border-transparent rounded px-2 py-1 editable-field"
              data-field="title"
            >{(entry as any).title}</h1>
            <p class="text-sm text-gray-500 mt-1">{(category as any).name}</p>
          </div>
        </div>
        
        <div class="flex gap-3">
          <button 
            id="saveBtn"
            class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 hidden"
          >
            💾 Guardar Cambios
          </button>
          <button 
            id="deleteBtn"
            class="px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100"
          >
            Eliminar
          </button>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Contenido Principal -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Barra de Progreso -->
        <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-semibold text-gray-900">Progreso de Completitud</h2>
            <span class="text-2xl font-bold text-indigo-600">{progress}%</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-3 mb-2">
            <div 
              class="bg-indigo-600 h-3 rounded-full transition-all" 
              style={`width: ${progress}%`}
            ></div>
          </div>
          <p class="text-sm text-gray-500">
            {completedFields} de {totalFields} campos completados
          </p>
        </div>

        <!-- Campos Editables -->
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Datos</h2>
            <p class="text-xs text-gray-500 mt-1">Click en cualquier campo para editarlo directamente</p>
          </div>
          <div class="p-6 space-y-4">
            {fieldsWithCompletion.map((field: any) => {
              const value = entryData[field.name];
              const isEmpty = value === undefined || value === null || value === '';
              
              return (
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-start justify-between mb-2">
                    <div class="flex items-center gap-2 flex-1">
                      <input 
                        type="checkbox" 
                        class="field-completion-checkbox w-5 h-5 text-indigo-600 rounded"
                        data-field-id={field.id}
                        data-entry-id={id}
                        checked={field.is_complete}
                      />
                      <div>
                        <h3 class="font-semibold text-gray-900">{field.label}</h3>
                        <p class="text-xs text-gray-500">{field.name} • {field.type}</p>
                      </div>
                    </div>
                    <span class={`px-2 py-0.5 rounded text-xs font-medium ${
                      field.is_complete ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'
                    }`}>
                      {field.is_complete ? 'Completo' : 'Pendiente'}
                    </span>
                  </div>
                  
                  {field.help_text && (
                    <p class="text-xs text-gray-500 mb-2 ml-7">{field.help_text}</p>
                  )}
                  
                  <div class="ml-7 mt-2">
                    {/* {field.type === 'relation' ? (
                      <div>
                        {(() => {
                          const config = JSON.parse(field.config || '{}');
                          const relatedCategoryId = config.related_category_id;
                          
                          if (!value) return <p class="text-sm text-gray-500 italic">Sin relación</p>;
                          
                          // Obtener datos de las entradas relacionadas
                          const relatedIds = Array.isArray(value) ? value : [value];
                          
                          return (
                            <div class="flex flex-wrap gap-2">
                              {relatedIds.map((id: string) => {
                                const relatedEntry = db.prepare('SELECT * FROM entries WHERE id = ?').get(id);
                                if (!relatedEntry) return null;
                                
                                const relatedCategory = db.prepare('SELECT * FROM categories WHERE id = ?').get(relatedCategoryId);
                                
                                return (
                                  <a 
                                    href={`/entries/${relatedCategory.slug}/${id}`}
                                    class="inline-flex items-center gap-2 px-3 py-2 bg-white border-2 border-indigo-200 rounded-lg hover:border-indigo-400 transition"
                                  >
                                    <div class="w-2 h-2 rounded-full" style={`background-color: ${relatedCategory.color}`}></div>
                                    <span class="font-medium text-gray-900">{relatedEntry.title}</span>
                                    <span class="text-xs text-gray-500">({relatedCategory.name})</span>
                                  </a>
                                );
                              })}
                            </div>
                          );
                        })()}
                      </div>
                    ) : ( }*/}
                      <FieldRenderer field={field} value={entryData[field.name]}/>
                    {/* )} */}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Tareas -->
        <EntryTasksWidget entryId={id} categoryId={(category as any).id} />

        <!-- Información -->
        <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Información</h2>
          <dl class="space-y-3">
            <div>
              <dt class="text-xs font-medium text-gray-500">ID</dt>
              <dd class="text-sm text-gray-900 font-mono">{id}</dd>
            </div>
            <div>
              <dt class="text-xs font-medium text-gray-500">Creado</dt>
              <dd class="text-sm text-gray-900">
                {new Date((entry as any).created_at).toLocaleDateString('es-ES')}
              </dd>
            </div>
            <div>
              <dt class="text-xs font-medium text-gray-500">Última Actualización</dt>
              <dd class="text-sm text-gray-900">
                {new Date((entry as any).updated_at).toLocaleDateString('es-ES')}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </main>

  <script>
    const entryId = document.body.dataset.entryId!;
    let hasChanges = false;
    let currentData: any = {};
    let pendingSaves = new Set();

    // Cargar datos actuales
    async function loadCurrentData() {
      try {
        const response = await fetch(`/api/entries?id=${entryId}`);
        const entry = await response.json();
        currentData = JSON.parse(entry.data);
      } catch (error) {
        console.error('Error loading data:', error);
      }
    }

    loadCurrentData();

    // Detectar cambios
    document.querySelectorAll('.editable-field').forEach(field => {
      field.addEventListener('input', () => {
        hasChanges = true;
        document.getElementById('saveBtn')?.classList.remove('hidden');
      });

      field.addEventListener('change', () => {
        hasChanges = true;
        document.getElementById('saveBtn')?.classList.remove('hidden');
      });
    });

    // Listas dinámicas
    document.querySelectorAll('.add-list-item').forEach(btn => {
      btn.addEventListener('click', async () => {
        const fieldName = (btn as HTMLElement).dataset.field!;
        const input = document.querySelector(`[data-list-input="${fieldName}"]`) as HTMLInputElement;
        
        if (!input || !input.value.trim()) return;
        
        const newValue = input.value.trim();
        
        // Actualizar UI inmediatamente (optimista)
        if (!currentData[fieldName]) currentData[fieldName] = [];
        currentData[fieldName].push(newValue);
        
        // Añadir elemento visual
        const container = input.closest('.space-y-2, div')?.querySelector('.flex.flex-wrap');
        if (container) {
          const tag = createTagElement(fieldName, newValue);
          container.appendChild(tag);
        }
        
        input.value = '';
        
        // Guardar en background
        saveOptimistic(fieldName);
      });
    });

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      
      if (target.classList.contains('remove-list-item') || target.closest('.remove-list-item')) {
        const btn = target.classList.contains('remove-list-item') ? target : target.closest('.remove-list-item')!;
        const fieldName = (btn as HTMLElement).dataset.field!;
        const item = (btn as HTMLElement).dataset.item!;
        
        // Actualizar estado inmediatamente
        if (currentData[fieldName]) {
          currentData[fieldName] = currentData[fieldName].filter((i: string) => i !== item);
        }
        
        // Eliminar elemento visual
        const tagElement = btn.closest('span, div');
        if (tagElement) {
          tagElement.style.opacity = '0';
          tagElement.style.transition = 'opacity 0.2s';
          setTimeout(() => tagElement.remove(), 200);
        }
        
        // Guardar en background
        saveOptimistic(fieldName);
      }
    });

    function createTagElement(fieldName: string, value: string): HTMLElement {
  const span = document.createElement('span');
  span.className = 'inline-flex items-center gap-1 px-2.5 py-1 bg-gray-100 text-gray-700 text-sm rounded-md transition-opacity';
  span.innerHTML = `
    ${value}
    <button 
      class="remove-list-item text-red-600 hover:text-red-800 ml-1"
      data-field="${fieldName}"
      data-item="${value}"
      type="button"
    >×</button>
  `;
  return span;
}

// Guardado optimista con debounce
let saveTimeout: number | null = null;

async function saveOptimistic(fieldName?: string) {
  // Cancelar guardado anterior pendiente
  if (saveTimeout) clearTimeout(saveTimeout);
  
  // Mostrar indicador visual
  showSaveIndicator('Guardando...');
  
  // Esperar 500ms para agrupar múltiples cambios
  saveTimeout = window.setTimeout(async () => {
    try {
      const response = await fetch('/api/entries', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: entryId,
          data: currentData
        })
      });
      
      if (response.ok) {
        showSaveIndicator('✓ Guardado', 'success');
      } else {
        throw new Error('Save failed');
      }
    } catch (error) {
      console.error('Error saving:', error);
      showSaveIndicator('Error al guardar', 'error');
      // Opcionalmente: revertir cambios en UI
    }
  }, 500);
}

// Indicador de guardado (toast discreto)
let saveIndicatorTimeout: number | null = null;

function showSaveIndicator(message: string, type: 'loading' | 'success' | 'error' = 'loading') {
  let indicator = document.getElementById('saveIndicator');
  
  if (!indicator) {
    indicator = document.createElement('div');
    indicator.id = 'saveIndicator';
    indicator.className = 'fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg z-50 text-sm font-medium transition-all';
    document.body.appendChild(indicator);
  }
  
  // Estilos según tipo
  const styles = {
    loading: 'bg-blue-600 text-white',
    success: 'bg-green-600 text-white',
    error: 'bg-red-600 text-white'
  };
  
  indicator.className = `fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg z-50 text-sm font-medium transition-all ${styles[type]}`;
  indicator.textContent = message;
  indicator.style.opacity = '1';
  
  // Auto-ocultar después de 2s (solo para success/error)
  if (type !== 'loading') {
    if (saveIndicatorTimeout) clearTimeout(saveIndicatorTimeout);
    saveIndicatorTimeout = window.setTimeout(() => {
      indicator!.style.opacity = '0';
    }, 2000);
  }
}

    // Upload imagen
    document.getElementById('imageUpload')?.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      
      const reader = new FileReader();
      reader.onload = async (event) => {
        const base64 = event.target?.result as string;
        
        // Guardar en data._image
        currentData._image = base64;
        
        try {
          await fetch('/api/entries', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: entryId,
              data: currentData
            })
          });
          
          window.location.reload();
        } catch (error) {
          alert('Error al guardar imagen');
        }
      };
      reader.readAsDataURL(file);
    });

    // Checkboxes completitud
    document.querySelectorAll('.field-completion-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', async (e) => {
        const target = e.target as HTMLInputElement;
        const fieldId = target.dataset.fieldId;
        const isComplete = target.checked;
        
        try {
          const response = await fetch('/api/field-completion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              entry_id: entryId,
              field_id: fieldId,
              is_complete: isComplete
            })
          });
          
          if (response.ok) {
            window.location.reload();
          }
        } catch (error) {
          target.checked = !isComplete;
        }
      });
    });

    // Eliminar entrada
    document.getElementById('deleteBtn')?.addEventListener('click', async () => {
      if (!confirm('¿Eliminar esta entrada?')) return;
      
      try {
        const response = await fetch('/api/entries', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: entryId })
        });
        
        if (response.ok) {
          window.location.href = `/entries/${window.location.pathname.split('/')[2]}`;
        }
      } catch (error) {
        alert('Error al eliminar');
      }
    });

    // Advertencia al salir sin guardar
    window.addEventListener('beforeunload', (e) => {
      if (hasChanges) {
        e.preventDefault();
        e.returnValue = '';
      }
    });

    document.addEventListener('DOMContentLoaded', async () => {
  // Cargar opciones para campos de relación
  const relationFields = document.querySelectorAll('.relation-select');
  
  for (const select of relationFields) {
    const fieldName = (select as HTMLElement).dataset.field!;
    const container = document.getElementById(`relation-${fieldName}`);
    const relatedCategoryId = container?.dataset.category;
    
    if (!relatedCategoryId) continue;
    
    try {
      // Obtener entradas de la categoría relacionada
      const response = await fetch(`/api/entries?category_id=${relatedCategoryId}`);
      const entries = await response.json();
      
      // Llenar select
      (select as HTMLSelectElement).innerHTML = 
        '<option value="">Selecciona...</option>' +
        entries.map((entry: any) => {
          const isSelected = currentData[fieldName] === entry.id || 
                           (Array.isArray(currentData[fieldName]) && currentData[fieldName].includes(entry.id));
          return `<option value="${entry.id}" ${isSelected ? 'selected' : ''}>${entry.title}</option>`;
        }).join('');
      
      // Si es múltiple, manejar selección
      if ((select as HTMLElement).dataset.multiple === 'true') {
        select.addEventListener('change', (e) => {
          const selectedId = (e.target as HTMLSelectElement).value;
          if (!selectedId) return;
          
          if (!currentData[fieldName]) currentData[fieldName] = [];
          if (!currentData[fieldName].includes(selectedId)) {
            currentData[fieldName].push(selectedId);
          }
          
          // Añadir badge visual
          const selectedContainer = document.getElementById(`selected-${fieldName}`);
          const selectedEntry = entries.find((e: any) => e.id === selectedId);
          
          if (selectedContainer && selectedEntry) {
            const badge = document.createElement('span');
            badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-100 text-indigo-700 rounded-md text-sm';
            badge.innerHTML = `
              ${selectedEntry.title}
              <button class="remove-relation text-red-600 hover:text-red-800" data-field="${fieldName}" data-id="${selectedId}">×</button>
            `;
            selectedContainer.appendChild(badge);
          }
          
          (e.target as HTMLSelectElement).value = '';
          hasChanges = true;
          document.getElementById('saveBtn')?.classList.remove('hidden');
        });
      }
      
    } catch (error) {
      console.error('Error loading relation options:', error);
    }
  }
  
  // Manejar eliminación de relaciones múltiples
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('remove-relation')) {
      const fieldName = target.dataset.field!;
      const idToRemove = target.dataset.id!;
      
      if (currentData[fieldName]) {
        currentData[fieldName] = currentData[fieldName].filter((id: string) => id !== idToRemove);
      }
      
      target.closest('span')?.remove();
      hasChanges = true;
      document.getElementById('saveBtn')?.classList.remove('hidden');
    }
  });
});

// Upload con indicador de progreso
document.getElementById('imageUpload')?.addEventListener('change', async (e) => {
  const file = (e.target as HTMLInputElement).files?.[0];
  if (!file) return;
  
  // Validación del lado del cliente
  if (!file.type.startsWith('image/')) {
    alert('Por favor selecciona una imagen válida');
    return;
  }
  
  if (file.size > 5 * 1024 * 1024) {
    alert('La imagen es demasiado grande. Máximo 5MB');
    return;
  }
  
  // Mostrar indicador de carga
  const placeholder = document.getElementById('imagePlaceholder')!;
  placeholder.innerHTML = `
    <div class="text-center">
      <svg class="animate-spin w-8 h-8 text-indigo-600 mx-auto" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-xs text-gray-500 mt-2">Subiendo...</p>
    </div>
  `;
  placeholder.style.display = 'flex';
  
  try {
    const formData = new FormData();
    formData.append('image', file);
    
    const uploadResponse = await fetch('/api/upload-image', {
      method: 'POST',
      body: formData
    });
    
    if (!uploadResponse.ok) {
      const error = await uploadResponse.json();
      throw new Error(error.error || 'Error al subir imagen');
    }
    
    const { url } = await uploadResponse.json();
    
    // Actualizar la entrada con la nueva URL
    currentData._image = url;
    
    const response = await fetch('/api/entries', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: entryId,
        data: currentData
      })
    });
    
    if (response.ok) {
      // Actualizar imagen sin recargar página
      const img = document.getElementById('entryImage') as HTMLImageElement;
      img.src = url;
      img.style.display = 'block';
      placeholder.style.display = 'none';
      
      // Restaurar placeholder original
      placeholder.innerHTML = `
        <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      `;
    } else {
      throw new Error('Error al guardar');
    }
  } catch (error) {
    console.error('Error:', error);
    alert(error instanceof Error ? error.message : 'Error al subir imagen');
    
    // Restaurar placeholder
    placeholder.style.display = 'flex';
    placeholder.innerHTML = `
      <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    `;
  }
});

// Eliminar imagen
document.getElementById('removeImageBtn')?.addEventListener('click', async (e) => {
  e.preventDefault();
  e.stopPropagation();
  
  if (!confirm('¿Eliminar la imagen?')) return;
  
  currentData._image = null;
  
  try {
    await fetch('/api/entries', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: entryId,
        data: currentData
      })
    });
    
    // Ocultar imagen, mostrar placeholder
    const img = document.getElementById('entryImage') as HTMLImageElement;
    img.style.display = 'none';
    document.getElementById('imagePlaceholder')!.style.display = 'flex';
    
  } catch (error) {
    alert('Error al eliminar imagen');
  }
});
  </script>
</body>
</html>