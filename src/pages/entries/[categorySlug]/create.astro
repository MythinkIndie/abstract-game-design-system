---
// src/pages/entries/[categorySlug]/create.astro
import { getSupabaseClient } from '@/lib/supabaseClient';

const { categorySlug } = Astro.params;

const supabase = getSupabaseClient();
const category = await supabase.from('categories').select('*').eq('slug', categorySlug).single();

if (!category.data || category.data.length === 0) {
  return Astro.redirect('/categories');
}

const fields = await supabase.from('fields').select('*').eq('category_id', (category.data as any).id).order('field_order', { ascending: true });

---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nueva Entrada - {(category.data as any).name}</title>
</head>
<body class="bg-gray-50 min-h-screen" 
  data-category-id={(category.data as any).id} 
  data-category-slug={categorySlug}
  data-fields={JSON.stringify(fields.data || [])}>
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <a href={`/entries/${categorySlug}`} class="text-sm text-gray-500 hover:text-gray-700">← Volver a entradas</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1">Nueva Entrada: {(category.data as any).name}</h1>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <form id="entryForm" class="bg-white rounded-lg shadow border border-gray-200 p-8 space-y-6">
      {fields.data && [...fields.data.slice(-4), ...fields.data.slice(0, -4)].map((field: any) => {
        const config = field.config ? JSON.parse(field.config) : {};
        
        return (
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              {field.label}
              {field.required === 1 && <span class="text-red-500">*</span>}
            </label>
            
            {field.type === 'text' && (
              <input 
                type="text"
                name={field.name}
                required={field.required === 1}
                placeholder={config.placeholder || ''}
                maxlength={config.max_length || undefined}
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
              />
            )}
            
            {field.type === 'number' && (
              <input 
                type="number"
                name={field.name}
                required={field.required === 1}
                min={config.min !== undefined ? config.min : undefined}
                max={config.max !== undefined ? config.max : undefined}
                step={config.step || 1}
                value={config.default || ''}
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
              />
            )}
            
            {field.type === 'boolean' && (
              <div class="flex items-center">
                <input 
                  type="checkbox"
                  name={field.name}
                  checked={config.default === true}
                  class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500"
                />
                <span class="ml-2 text-sm text-gray-600">{field.help_text || 'Marcar si aplica'}</span>
              </div>
            )}
            
            {field.type === 'markdown' && (
              <textarea 
                name={field.name}
                required={field.required === 1}
                rows="8"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent font-mono text-sm"
                placeholder="Soporta Markdown: # Título, **negrita**, *cursiva*, etc."
              ></textarea>
            )}
            
            {field.type === 'enum' && config.options && (
              <select 
                name={field.name}
                required={field.required === 1}
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
              >
                <option value="">Selecciona una opción...</option>
                {config.options.map((option: string) => (
                  <option value={option} selected={option === config.default}>
                    {option}
                  </option>
                ))}
              </select>
            )}
            
            {field.type === 'list' && (
              <div>
                <div id={`list-${field.name}`} class="space-y-2 mb-2">
                  <div class="flex gap-2">
                    <input 
                      type="text"
                      placeholder="Añadir elemento..."
                      class="flex-1 px-4 py-2 border border-gray-300 rounded-lg"
                    />
                    <button 
                      type="button"
                      class="add-list-item px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700"
                      data-field={field.name}
                    >
                      +
                    </button>
                  </div>
                </div>
                <input type="hidden" name={field.name} value="[]" />
              </div>
            )}
            
            {field.type === 'json' && (
              <textarea 
                name={field.name}
                required={field.required === 1}
                rows="6"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent font-mono text-sm"
                placeholder='{"key": "value"}'
              ></textarea>
            )}
            
            {field.help_text && field.type !== 'boolean' && (
              <p class="text-xs text-gray-500 mt-1">{field.help_text}</p>
            )}
          </div>
        );
      })}
      
      <div class="flex gap-3 pt-4 border-t border-gray-200">
        <button 
          type="submit"
          class="flex-1 px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-medium"
        >
          Crear Entrada
        </button>
        <a 
          href={`/entries/${categorySlug}`}
          class="px-6 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition font-medium"
        >
          Cancelar
        </a>
      </div>
    </form>
  </main>

  <script>
    const categoryId = document.body.dataset.categoryId;
    const categorySlug = document.body.dataset.categorySlug;
    const fieldsData = JSON.parse(document.body.dataset.fields || '[]');
    
    console.log('Category ID:', categoryId);
    console.log('Fields:', fieldsData);
    
    const form = document.getElementById('entryForm');
    
    // Manejar listas dinámicas
    document.querySelectorAll('.add-list-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const fieldName = (btn as HTMLElement).dataset.field;
        const container = document.getElementById(`list-${fieldName}`);
        const input = container?.querySelector('input[type="text"]') as HTMLInputElement;
        const hiddenInput = document.querySelector(`input[name="${fieldName}"]`) as HTMLInputElement;
        
        if (input && input.value.trim()) {
          const currentList = JSON.parse(hiddenInput.value || '[]');
          currentList.push(input.value.trim());
          hiddenInput.value = JSON.stringify(currentList);
          
          const itemDiv = document.createElement('div');
          itemDiv.className = 'flex items-center gap-2 text-sm';
          itemDiv.innerHTML = `
            <span class="flex-1 px-3 py-1 bg-gray-100 rounded">${input.value.trim()}</span>
            <button type="button" class="text-red-600 hover:text-red-800">×</button>
          `;
          
          itemDiv.querySelector('button')?.addEventListener('click', () => {
            const list = JSON.parse(hiddenInput.value);
            const index = list.indexOf(input.value.trim());
            if (index > -1) list.splice(index, 1);
            hiddenInput.value = JSON.stringify(list);
            itemDiv.remove();
          });
          
          container?.appendChild(itemDiv);
          input.value = '';
        }
      });
    });
    
    // Submit form
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target as HTMLFormElement);
      const data: any = {};
      
      console.log('Processing form...');
      
      // Construir objeto de datos según los campos
      fieldsData.forEach((field: any) => {
    const fieldName = field.name;
    const fieldType = field.type;
    const fieldConfig = JSON.parse(field.config || '{}');
    
    console.log(`Processing field: ${fieldName} (type: ${fieldType})`);
    
    if (fieldType === 'boolean') {
      data[fieldName] = formData.has(fieldName);
    } 
    else if (fieldType === 'number') {
      const value = formData.get(fieldName);
      const numValue = value ? parseFloat(value as string) : null;
      data[fieldName] = isNaN(numValue as number) ? null : numValue;
    } 
    else if (fieldType === 'list') {
      try {
        const value = formData.get(fieldName);
        data[fieldName] = value ? JSON.parse(value as string) : [];
      } catch {
        data[fieldName] = [];
      }
    } 
    else if (fieldType === 'json') {
      try {
        const value = formData.get(fieldName);
        data[fieldName] = value ? JSON.parse(value as string || '{}') : {};
      } catch (error) {
        alert(`Error en JSON del campo ${fieldName}`);
        throw error;
      }
    }
    else if (fieldType === 'relation') {
      // MANEJAR RELACIONES
      const allowMultiple = fieldConfig.allow_multiple;
      
      if (allowMultiple) {
        // Para múltiples: buscar en el array temporal
        const hiddenInput = document.querySelector(`input[name="${fieldName}"][type="hidden"]`) as HTMLInputElement;
        if (hiddenInput) {
          try {
            data[fieldName] = JSON.parse(hiddenInput.value);
          } catch {
            data[fieldName] = [];
          }
        } else {
          data[fieldName] = [];
        }
      } else {
        // Para único: obtener valor del select
        const select = document.querySelector(`.relation-select[data-field="${fieldName}"]`) as HTMLSelectElement;
        data[fieldName] = select?.value || null;
      }
      
      console.log(`Relation field ${fieldName}:`, data[fieldName]);
    }
    else {
      // text, markdown, enum, etc.
      data[fieldName] = formData.get(fieldName) || '';
    }
  });
  
  // El título es obligatorio
  const title = data.title || 'Sin título';
  
  console.log('Final data:', data);
  console.log('Title:', title);
  
  const payload = {
    category_id: categoryId,
    title: title,
    data: data
  };
  
  console.log('Sending payload:', payload);
  
  try {
    const response = await fetch('/api/entries', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    
    console.log('Response status:', response.status);
    
    const result = await response.json();
    console.log('Response data:', result);
    
    if (response.ok) {
      console.log('Success! Redirecting...');
      window.location.href = `/entries/${categorySlug}/${result.id}`;
    } else {
      console.error('Error from API:', result);
      alert(`Error: ${result.error || 'Unknown error'}`);
    }
  } catch (error) {
    console.error('Network error:', error);
    alert('Error al crear la entrada. Revisa la consola.');
  }
    });

    document.addEventListener('DOMContentLoaded', async () => {
  const relationSelects = document.querySelectorAll('.relation-select');
  
  for (const select of relationSelects) {
    const fieldName = (select as HTMLElement).dataset.field!;
    const relatedCategoryId = (select as HTMLElement).dataset.category!;
    const allowMultiple = (select as HTMLElement).dataset.multiple === 'true';
    
    try {
      const response = await fetch(`/api/entries?category_id=${relatedCategoryId}`);
      const entries = await response.json();
      
      entries.forEach((entry: any) => {
        const option = document.createElement('option');
        option.value = entry.id;
        option.textContent = entry.title;
        select.appendChild(option);
      });
      
      // Para múltiples, usar un array temporal
      if (allowMultiple) {
        const selectedIds: string[] = [];
        
        select.addEventListener('change', (e) => {
          const selectedId = (e.target as HTMLSelectElement).value;
          if (selectedId && !selectedIds.includes(selectedId)) {
            selectedIds.push(selectedId);
            
            // Crear badge visual
            const container = select.closest('.relation-field-container');
            if (container) {
              let badgeContainer = container.querySelector('.selected-badges');
              if (!badgeContainer) {
                badgeContainer = document.createElement('div');
                badgeContainer.className = 'selected-badges flex flex-wrap gap-2 mb-2';
                select.parentElement?.insertBefore(badgeContainer, select);
              }
              
              const badge = document.createElement('span');
              badge.className = 'inline-flex items-center gap-1 px-2 py-1 bg-indigo-100 text-indigo-700 rounded text-sm';
              badge.innerHTML = `
                ${(e.target as HTMLSelectElement).selectedOptions[0].text}
                <button type="button" class="remove-temp-relation" data-id="${selectedId}">×</button>
              `;
              badgeContainer.appendChild(badge);
            }
            
            // Quitar del select
            const option = select.querySelector(`option[value="${selectedId}"]`);
            if (option) option.remove();
            
            (e.target as HTMLSelectElement).value = '';
          }
        });
        
        // Manejar eliminación temporal
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.classList.contains('remove-temp-relation')) {
            const idToRemove = target.dataset.id!;
            const index = selectedIds.indexOf(idToRemove);
            if (index > -1) selectedIds.splice(index, 1);
            target.closest('span')?.remove();
          }
        });
        
        // Al enviar, incluir los IDs seleccionados
        const form = document.getElementById('entryForm');
        if (form) {
          const originalSubmit = form.onsubmit;
          form.onsubmit = function(e) {
            // Añadir campo hidden con los IDs
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = fieldName;
            input.value = JSON.stringify(selectedIds);
            form.appendChild(input);
            
            if (originalSubmit) return originalSubmit.call(this, e);
          };
        }
      }
      
    } catch (error) {
      console.error('Error loading relation options:', error);
    }
  }
});
document.addEventListener('DOMContentLoaded', async () => {
  const relationSelects = document.querySelectorAll('.relation-select');
  
  // Mapa para almacenar selecciones temporales
  const relationSelections = new Map<string, string[]>();
  
  for (const select of relationSelects) {
    const fieldName = (select as HTMLElement).dataset.field!;
    const relatedCategoryId = (select as HTMLElement).dataset.category!;
    const allowMultiple = (select as HTMLElement).dataset.multiple === 'true';
    
    // Inicializar array si es múltiple
    if (allowMultiple) {
      relationSelections.set(fieldName, []);
    }
    
    try {
      // Cargar opciones
      const response = await fetch(`/api/entries?category_id=${relatedCategoryId}`);
      const entries = await response.json();
      
      entries.forEach((entry: any) => {
        const option = document.createElement('option');
        option.value = entry.id;
        option.textContent = entry.title;
        select.appendChild(option);
      });
      
      // Manejar selección
      select.addEventListener('change', (e) => {
        const selectedId = (e.target as HTMLSelectElement).value;
        const selectedText = (e.target as HTMLSelectElement).selectedOptions[0]?.text;
        
        if (!selectedId) return;
        
        if (allowMultiple) {
          const selections = relationSelections.get(fieldName) || [];
          
          if (!selections.includes(selectedId)) {
            selections.push(selectedId);
            relationSelections.set(fieldName, selections);
            
            // Actualizar hidden input
            const hiddenInput = document.querySelector(`input[name="${fieldName}"][type="hidden"]`) as HTMLInputElement;
            if (hiddenInput) {
              hiddenInput.value = JSON.stringify(selections);
            }
            
            // Añadir badge visual
            const container = select.closest('.relation-field-container');
            const badgeContainer = container?.querySelector('.selected-badges');
            
            if (badgeContainer) {
              const badge = document.createElement('span');
              badge.className = 'inline-flex items-center gap-2 px-3 py-1 bg-indigo-100 text-indigo-700 rounded-md text-sm';
              badge.innerHTML = `
                <span>${selectedText}</span>
                <button 
                  type="button" 
                  class="remove-temp-relation hover:text-indigo-900" 
                  data-field="${fieldName}"
                  data-id="${selectedId}"
                  data-text="${selectedText}"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              `;
              badgeContainer.appendChild(badge);
            }
            
            // Quitar opción del select
            const option = select.querySelector(`option[value="${selectedId}"]`);
            if (option) option.remove();
          }
          
          (e.target as HTMLSelectElement).value = '';
        }
        // Si es único, no hacer nada especial (el select ya tiene el valor)
      });
      
    } catch (error) {
      console.error('Error loading relation options:', error);
    }
  }
  
  // Manejar eliminación de relaciones temporales
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.remove-temp-relation') as HTMLElement;
    
    if (btn) {
      const fieldName = btn.dataset.field!;
      const idToRemove = btn.dataset.id!;
      const text = btn.dataset.text!;
      
      // Quitar del array
      const selections = relationSelections.get(fieldName) || [];
      const newSelections = selections.filter(id => id !== idToRemove);
      relationSelections.set(fieldName, newSelections);
      
      // Actualizar hidden input
      const hiddenInput = document.querySelector(`input[name="${fieldName}"][type="hidden"]`) as HTMLInputElement;
      if (hiddenInput) {
        hiddenInput.value = JSON.stringify(newSelections);
      }
      
      // Eliminar badge
      btn.closest('span')?.remove();
      
      // Añadir opción de vuelta al select
      const select = document.querySelector(`.relation-select[data-field="${fieldName}"]`) as HTMLSelectElement;
      if (select) {
        const option = document.createElement('option');
        option.value = idToRemove;
        option.textContent = text;
        select.appendChild(option);
      }
    }
  });
});
  </script>
</body>
</html>