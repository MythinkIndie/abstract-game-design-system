---
const { assignedTo } = Astro.props;
---

<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Asignación</h2>
  
  <div id="assignedSection">
    {assignedTo ? (
      <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
        <div class="w-10 h-10 rounded-full bg-indigo-600 text-white flex items-center justify-center font-semibold">
          {assignedTo.substring(0, 2).toUpperCase()}
        </div>
        <div class="flex-1">
          <p class="font-medium text-gray-900">{assignedTo}</p>
          <p class="text-xs text-gray-500">Responsable</p>
        </div>
        <button id="removeAssignment" class="text-gray-400 hover:text-red-600" title="Quitar asignación">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    ) : (
      <p class="text-sm text-gray-500 italic mb-3">Sin asignar</p>
    )}
    
    <div class="mt-3">
      <label class="block text-sm font-medium text-gray-700 mb-2">Asignar a</label>
      <div class="flex gap-2">
        <input 
          type="text" 
          id="assignToInput"
          placeholder="Nombre o email"
          class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm"
        />
        <button id="assignBtn" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">
          Asignar
        </button>
      </div>
    </div>
  </div>
</div>