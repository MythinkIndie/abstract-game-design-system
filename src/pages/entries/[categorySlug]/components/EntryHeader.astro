---
const { entry, category, entryData } = Astro.props;
---

<header class="bg-white shadow-sm border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <a href={`/entries/${category.slug}`} class="text-sm text-gray-500 hover:text-gray-700">
      ← Volver a {category.name}
    </a>
    <div class="flex items-center justify-between mt-2">
      <div class="flex items-center gap-4 flex-1 min-w-0">
        <!-- Imagen -->
        <div class="relative group flex-shrink-0">
          <img 
            id="entryImage"
            src={entryData._image || '/placeholder.svg'}
            alt={entry.title}
            class="w-24 h-24 rounded-lg object-cover border-2 border-gray-200 bg-gray-100"
            onerror="this.style.display='none'; document.getElementById('imagePlaceholder').style.display='flex';"
          />
          
          <div 
            id="imagePlaceholder"
            class="w-24 h-24 rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 flex items-center justify-center"
            style={entryData._image ? 'display: none;' : ''}
          >
            <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          
          <label class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-0 group-hover:bg-opacity-60 rounded-lg cursor-pointer transition-all">
            <div class="opacity-0 group-hover:opacity-100 transition-opacity text-white text-center">
              <svg class="w-8 h-8 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
              <span class="text-xs font-medium">Subir</span>
            </div>
            <input type="file" id="imageUpload" accept="image/*" class="hidden" />
          </label>
          
          {entryData._image && (
            <button 
              id="removeImageBtn"
              class="absolute -top-2 -right-2 w-6 h-6 bg-red-600 text-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-700"
            >
              <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          )}
        </div>
        
        <div class="flex-1 min-w-0">
          <h1 
            id="entryTitle"
            contenteditable="true"
            class="text-2xl font-bold text-gray-900 border border-transparent rounded px-2 py-1 editable-field"
            data-field="title"
          >{entry.title}</h1>
          <p class="text-sm text-gray-500 mt-1">{category.name}</p>
        </div>
      </div>
      
      <div class="flex gap-3">
        <button id="saveBtn" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 hidden">
          💾 Guardar
        </button>
        <button id="deleteBtn" class="px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100">
          Eliminar
        </button>
      </div>
    </div>
  </div>
</header>