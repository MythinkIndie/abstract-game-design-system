---
// src/components/UserHeader.astro
const { username } = Astro.cookies.get('username') || {};
const showUser = !!username;
---

{showUser && (
  <div class="fixed top-4 right-4 z-50">
    <div class="bg-white rounded-lg shadow-lg border border-gray-200 p-3 flex items-center gap-3">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center">
          <span class="text-sm font-medium text-indigo-700">
            {username?.value.substring(0, 2).toUpperCase()}
          </span>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">{username?.value}</p>
          <p class="text-xs text-gray-500">En línea</p>
        </div>
      </div>
      <button 
        id="logoutBtn"
        class="ml-2 px-3 py-1 text-xs bg-red-50 text-red-600 rounded hover:bg-red-100 transition"
        title="Cerrar sesión"
      >
        Salir
      </button>
    </div>
  </div>
  
  <script>
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      if (!confirm('¿Cerrar sesión?')) return;
      
      try {
        await fetch('/api/auth/logout');
        window.location.href = '/login';
      } catch (error) {
        alert('Error al cerrar sesión');
      }
    });
  </script>
)}