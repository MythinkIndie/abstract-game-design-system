---
import db from '../lib/db';

interface Props {
  entryId: string;
  categoryId: string;
}

const { entryId, categoryId } = Astro.props;

const taskCategory = db.prepare('SELECT id FROM categories WHERE slug = ?').get('task') as any;
let applicableTasks: any[] = [];
let completionStats = { total: 0, completed: 0, percentage: 0 };

if (taskCategory) {
  const allTasks = db.prepare(`
    SELECT * FROM entries 
    WHERE category_id = ? 
      AND json_extract(data, '$.related_category_id') = ?
      AND (json_extract(data, '$.parent_task_id') IS NULL OR json_extract(data, '$.parent_task_id') = '')
    ORDER BY json_extract(data, '$.order_index') ASC
  `).all(taskCategory.id, categoryId) as any[];
  
  applicableTasks = allTasks.map(task => {
    const data = JSON.parse(task.data);
    const applies = data.applies_to_all || 
                   (data.specific_entry_ids && data.specific_entry_ids.includes(entryId));
    
    if (!applies) return null;
    
    const completion = db.prepare(`
      SELECT * FROM task_completion 
      WHERE task_id = ? AND entry_id = ?
    `).get(task.id, entryId) as any;
    
    return {
      ...task,
      data,
      is_completed: completion ? completion.is_completed === 1 : data.is_completed || false
    };
  }).filter(Boolean);
  
  completionStats.total = applicableTasks.length;
  completionStats.completed = applicableTasks.filter(t => t.is_completed).length;
  completionStats.percentage = completionStats.total > 0 
    ? Math.round((completionStats.completed / completionStats.total) * 100) 
    : 0;
}
---

<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">Tareas</h2>
    
    {/* BARRA DE PROGRESO */}
    {completionStats.total > 0 && (
      <div class="flex items-center gap-3">
        <div class="flex-1 w-24">
          <div class="w-full bg-gray-200 rounded-full h-2">
            <div 
              class={`h-2 rounded-full transition-all ${
                completionStats.percentage === 100 ? 'bg-green-600' :
                completionStats.percentage >= 50 ? 'bg-blue-600' :
                'bg-yellow-600'
              }`}
              style={`width: ${completionStats.percentage}%`}
            ></div>
          </div>
        </div>
        <span class="text-sm font-medium text-gray-700">
          {completionStats.completed}/{completionStats.total}
        </span>
      </div>
    )}
    
    <div class="flex gap-2">
      <button 
        id="linkExistingTaskBtn"
        class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded hover:bg-gray-200"
      >
        🔗 Vincular
      </button>
      <a 
        href={`/tasks/create?entry_id=${entryId}&category_id=${categoryId}`}
        class="px-3 py-1 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700"
      >
        + Nueva
      </a>
    </div>
  </div>

  {applicableTasks.length === 0 ? (
    <p class="text-sm text-gray-500 text-center py-8">
      No hay tareas asignadas a esta entrada
    </p>
  ) : (
    <div class="space-y-2">
      {applicableTasks.map((task: any) => (
        <div class={`flex items-start gap-3 p-3 border rounded-lg transition ${
          task.is_completed 
            ? 'border-green-200 bg-green-50' 
            : 'border-gray-200 hover:border-indigo-300'
        }`}>
          <input 
            type="checkbox" 
            class="entry-task-checkbox mt-1 w-5 h-5 rounded"
            data-task-id={task.id}
            data-entry-id={entryId}
            checked={task.is_completed}
          />
          <div class="flex-1">
            <a 
              href={`/tasks/${task.id}`}
              class={`font-medium hover:text-indigo-600 ${
                task.is_completed ? 'line-through text-gray-500' : 'text-gray-900'
              }`}
            >
              {task.data.title}
            </a>
            {task.data.description && (
              <p class="text-sm text-gray-500 mt-1 line-clamp-2">
                {task.data.description.substring(0, 100)}
              </p>
            )}
            <div class="flex items-center gap-2 mt-2 text-xs">
              <span class={`px-2 py-0.5 rounded font-medium ${
                task.data.priority === 'critical' ? 'bg-red-100 text-red-700' :
                task.data.priority === 'high' ? 'bg-orange-100 text-orange-700' :
                task.data.priority === 'medium' ? 'bg-blue-100 text-blue-700' :
                'bg-gray-100 text-gray-600'
              }`}>
                {task.data.priority}
              </span>
              {task.data.due_date && (
                <span class="text-gray-500">
                  📅 {new Date(task.data.due_date).toLocaleDateString('es-ES')}
                </span>
              )}
            </div>
          </div>
          
          {/* BOTÓN DESVINCULAR */}
          <button 
            class="unlink-task text-gray-400 hover:text-red-600 transition"
            data-task-id={task.id}
            data-entry-id={entryId}
            title="Desvincular tarea"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
            </svg>
          </button>
        </div>
      ))}
    </div>
  )}
</div>

<script define:vars={{ entryId, categoryId }}>
  // Marcar tarea como completada/pendiente
  document.querySelectorAll('.entry-task-checkbox').forEach(checkbox => {
    checkbox.addEventListener('change', async (e) => {
      const target = e.target;
      const taskId = target.dataset.taskId;
      const isCompleted = target.checked;
      
      try {
        const response = await fetch('/api/task-completion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            task_id: taskId,
            entry_id: entryId,
            is_completed: isCompleted
          })
        });
        
        if (!response.ok) {
          target.checked = !isCompleted;
          alert('Error al actualizar');
        } else {
          window.location.reload();
        }
      } catch (error) {
        target.checked = !isCompleted;
        alert('Error de red');
      }
    });
  });

  // Desvincular tarea
  document.querySelectorAll('.unlink-task').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget;
      const taskId = target.dataset.taskId;
      
      if (!confirm('¿Desvincular esta tarea de la entrada?')) return;
      
      try {
        // Obtener tarea actual
        const taskResponse = await fetch(`/api/entries?id=${taskId}`);
        const task = await taskResponse.json();
        const taskData = JSON.parse(task.data);
        
        // Quitar entry_id de specific_entry_ids
        let specificIds = taskData.specific_entry_ids || [];
        specificIds = specificIds.filter(id => id !== entryId);
        
        const response = await fetch('/api/tasks', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: taskId,
            specific_entry_ids: specificIds
          })
        });
        
        if (response.ok) {
          target.closest('.flex')?.remove();
          showToast('Tarea desvinculada');
        }
      } catch (error) {
        alert('Error al desvincular');
      }
    });
  });

  function showToast(message) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-4 right-4 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg z-50';
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2000);
  }
</script>