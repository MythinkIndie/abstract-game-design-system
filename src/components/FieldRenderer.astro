---
const { field, value, db, parentCategory } = Astro.props;
const isEmpty = value === undefined || value === null || value === '';
const config = field.config ? JSON.parse(field.config) : {};
---

{field.type === 'text' && (
  <input
    type="text"
    class="editable-field w-full px-3 py-2 border border-gray-300 rounded-lg"
    data-field={field.name}
    data-type="TEXTAREA"
    value={value || ''}
    placeholder={isEmpty ? '⚠️ Campo vacío - Click para editar' : ''}
  />
)}

{field.type === 'number' && (
  <input 
    type="number"
    class="editable-field w-full px-3 py-2 border border-gray-300 rounded-lg"
    data-field={field.name}
    data-type="number"
    value={value || ''}
    />
)}

{field.type === 'boolean' && (
    <label class="flex items-center gap-2">
        <input 
        type="checkbox"
        class="editable-field w-4 h-4 text-indigo-600 border-gray-300 rounded"
        data-field={field.name}
        data-type="boolean"
        checked={value === true}
        />
        <span class="text-sm text-gray-600">
            {field.help_text || 'Marcar si aplica'}
        </span>
    </label>
)}
<!-- EXPLICACIÓN del Markdown:
  Problema: El valor de {value} genera saltos de línea si se coloca en líneas separadas
  Solución: Mantener {value} pegado a las etiquetas sin espacios
  
  Antes (incorrecto):
  <textarea>
    {value || ''}
  </textarea>
  
  Después (correcto):
  <textarea>{value || ''}</textarea>
  
  También añadido:
  - leading-normal: line-height estándar (evita espacio extra)
  - resize-y: permite redimensionar verticalmente
-->
{field.type === 'markdown' && (
  <textarea 
    class="editable-field w-full px-3 py-2 border border-gray-300 rounded-lg font-mono text-sm leading-normal resize-y"
    data-field={field.name}
    data-type="TEXTAREA"
    rows="6"
    placeholder={isEmpty ? '⚠️ Campo vacío - Click para editar' : 'Soporta Markdown'}
  >{value || ''}</textarea>
)}
{field.type === 'enum' && (
  <select 
    class="editable-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500"
    data-field={field.name} 
    data-type="enum"
  > 
    <option value="">Selecciona...</option> 
    {JSON.parse(field.config || '{}').options?.map((opt: string) => ( 
      <option value={opt} selected={opt === value}>{opt}</option> 
    ))} 
  </select>
)}

{field.type === 'list' && (
  <div>
    {/* Lista actual */}
    {value && value.length > 0 ? (
      <div class="flex flex-wrap gap-2 mb-3">
        {value.map((item: any) => (
          <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-gray-100 text-gray-700 text-sm rounded-md transition-opacity">
            {item}
            <button
              class="remove-list-item text-red-600 hover:text-red-800 ml-1"
              data-field={field.name}
              data-item={item}
              type="button"
            >×</button>
          </span>
        ))}
      </div>
    ) : (
      <p class="text-sm text-gray-500 italic mb-3">Sin elementos</p>
    )}

    {/* Input para añadir */}
    <div class="flex gap-2">
      <input
        type="text"
        class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500"
        placeholder="Añadir elemento..."
        data-list-input={field.name}
        onKeyPress={(e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            document.querySelector(`[data-field="${field.name}"].add-list-item`)?.click();
          }
        }}
      />
      <button
        class="add-list-item px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium transition"
        data-field={field.name}
        type="button"
      >
        +
      </button>
    </div>
  </div>
)}

{field.type === 'json' && (
    <textarea 
        class="editable-field w-full px-3 py-2 border border-gray-300 rounded-lg font-mono text-sm"
        data-field={field.name}
        data-type="json"
        rows="6"
        placeholder='{"key": "value"}'>
        {JSON.stringify(value, null, 2)}
    </textarea>
)}

{field.type === 'relation' && (() => {
  const config = JSON.parse(field.config || '{}');
  const allowMultiple = config.allow_multiple;
  const relatedCategoryId = config.related_category_id;
  
  if (!relatedCategoryId) {
    return (
      <div class="p-3 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-700">⚠️ Error: Campo sin categoría configurada</p>
      </div>
    );
  }
  
  const relatedCategory = db.prepare('SELECT * FROM categories WHERE id = ?').get(relatedCategoryId);
  
  if (!relatedCategory) {
    return (
      <div class="p-3 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-700">⚠️ Error: Categoría no existe</p>
      </div>
    );
  }
  
  // Detectar si es una auto-relación
  const isSelfRelation = relatedCategoryId === (parentCategory as any).id;
  
  return (
    <div class="relation-field-container" data-field-name={field.name}>
      {/* Mostrar relaciones actuales */}
      {value && (Array.isArray(value) ? value.length > 0 : value) && (
        <div class="flex flex-wrap gap-2 mb-3">
          {(Array.isArray(value) ? value : [value]).map((relatedId: string) => {
            const relatedEntry = db.prepare('SELECT * FROM entries WHERE id = ?').get(relatedId);
            
            if (!relatedEntry) {
              return (
                <div class="inline-flex items-center gap-2 px-3 py-2 bg-red-50 border border-red-200 rounded-lg">
                  <span class="text-xs text-red-700">⚠️ Eliminada</span>
                  <button 
                    class="remove-relation text-red-600 hover:text-red-800"
                    data-field={field.name}
                    data-id={relatedId}
                    type="button"
                  >×</button>
                </div>
              );
            }
            
            return (
              <div class="inline-flex items-center gap-2 px-3 py-2 bg-white border-2 border-indigo-200 rounded-lg group hover:border-indigo-400 transition">
                <div 
                  class="w-3 h-3 rounded-full flex-shrink-0" 
                  style={`background-color: ${(relatedCategory as any).color}`}
                ></div>
                <div class="flex flex-col">
                  <a 
                    href={`/entries/${(relatedCategory as any).slug}/${relatedId}`}
                    class="font-medium text-gray-900 hover:text-indigo-600 text-sm"
                    target="_blank"
                  >
                    {(relatedEntry as any).title}
                  </a>
                  {isSelfRelation && (
                    <span class="text-xs text-gray-500">{(relatedCategory as any).name}</span>
                  )}
                </div>
                <button 
                  class="remove-list-item-relation opacity-0 group-hover:opacity-100 text-red-600 hover:text-red-800 transition ml-2 flex-shrink-0"
                  data-field={field.name}
                  data-id={relatedId}
                  type="button"
                  title="Eliminar relación"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            );
          })}
        </div>
      )}
      
      {/* Select - excluir la entrada actual en auto-relaciones */}
      <div class="flex gap-2">
        <select 
          class="relation-select flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500"
          data-field-select-relation={field.name}
          data-category={relatedCategoryId}
          data-multiple={allowMultiple ? 'true' : 'false'}
          data-self-relation={isSelfRelation ? 'true' : 'false'}
        >
          <option value="">
            {allowMultiple ? '+ Añadir relación' : 'Selecciona...'}
          </option>
        </select>
        
        <button
        class="add-list-item-relation px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium transition"
        data-field={field.name}
        data-target-category={relatedCategoryId}
        data-multiple={allowMultiple ? 'true' : 'false'}
        type="button"
        >
          +
        </button>
        <a 
          href={`/entries/${(relatedCategory as any).slug}`}
          target="_blank"
          class="px-3 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm flex items-center gap-2"
          title={`Ver todas las entradas de ${(relatedCategory as any).name}`}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
      
      <p class="text-xs text-gray-500 mt-2">
        {isSelfRelation ? (
          <span>🔄 Auto-relación con <strong>{(relatedCategory as any).name}</strong></span>
        ) : (
          <span>Relacionado con: <strong>{(relatedCategory as any).name}</strong></span>
        )}
        {allowMultiple && ' (múltiple)'}
      </p>
    </div>
  );
})()}


<style>
  /* CSS adicional para controlar whitespace en textareas */
  textarea.editable-field {
    white-space: pre-wrap; /* Respeta saltos de línea pero ajusta texto */
    line-height: 1.5; /* Espaciado normal */
    min-height: 120px; /* Altura mínima razonable */
  }
  
  /* Eliminar padding extra en vacío */
  textarea.editable-field:empty {
    padding-top: 0.5rem;
  }
</style>